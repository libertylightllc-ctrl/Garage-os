// GarageOS — Phase 1 MVP schema (UAE-only). See docs/GarageOS-Technical-Spec.md §2.
// Money is ALWAYS Decimal, never Float. Staff = User (auth); Customer = passwordless.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------
enum Role {
  OWNER
  ADVISOR
  TECH
  CASHIER
}

enum Lang {
  ar
  en
  hi
  ur
}

enum BookingChannel {
  WA
  WEB
  PHONE
}

enum BookingStatus {
  PROPOSED
  CONFIRMED
  REJECTED
}

enum HoldReason {
  AWAITING_PART
  AWAITING_CUSTOMER
  AWAITING_APPROVAL
  OTHER
}

enum JobStatus {
  ARRIVED
  INSPECTION
  ESTIMATE
  APPROVED
  REPAIR
  TECH_COMPLETE   // tech tapped 'Mark complete'; awaiting cashier to finalise invoice
  INVOICED
  DELIVERED
  ON_HOLD
  CANCELLED
}

enum EstimateStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

enum ClearanceStatus {
  NA
  PENDING
  CLEARED
}

enum LineKind {
  LABOR
  PART
  FEE
}

enum WaConnStatus {
  CONNECTED
  DISCONNECTED
}

enum WaMode {
  BOT
  HUMAN
}

enum WaThreadStatus {
  OPEN
  NEEDS_HUMAN
  CLOSED
}

enum WaMsgState {
  RECEIVED
  SENT
  PENDING_APPROVAL
  DRAFT
}

enum WaDirection {
  IN
  OUT
}

enum AiKind {
  INTAKE
  COPILOT
  OCR
  RECEPTIONIST
}

// Part-request loop (Tier 1 #3). Open states (REQUESTED/ORDERED/ARRIVED) block the
// job; FULFILLED/CANCELLED close it. Out-of-stock requests auto-pause AWAITING_PART.
enum PartRequestStatus {
  REQUESTED
  ORDERED
  ARRIVED
  FULFILLED
  CANCELLED
}

// Maintenance reminders (Workflow-Spec step 16). Interval is date-based; the
// message asks the customer to check their own mileage.
enum ReminderType {
  OIL_5000
  OIL_10000
  BATTERY
  TIRE_ROTATION
  BRAKES
  AC_SERVICE
  AIR_FILTER
  COOLANT
  TRANSMISSION
}

enum ReminderStatus {
  SCHEDULED
  SENT
  CANCELLED
}

// Job-card Reception fields (Job-Card-Data-Model.md).
enum OilType {
  KM_5000
  KM_10000
  NONE
}

enum FuelLevel {
  EMPTY
  QUARTER
  HALF
  THREE_QUARTER
  FULL
}

// Technician parts list (Job-Card-Data-Model.md). REQUIRED = quoted at diagnosis;
// USED = actual at repair (USED handled in a later stage).
enum JobPartKind {
  REQUIRED
  USED
}

// ---------- Tenancy ----------
model Garage {
  id           String  @id @default(cuid())
  name         String
  country      String  @default("UAE")
  trn          String? // tax registration number (was vatNumber)
  branchOfId   String? // Phase-2 hook; Phase 1 is single-garage
  branchOf     Garage? @relation("GarageBranches", fields: [branchOfId], references: [id])
  branches     Garage[] @relation("GarageBranches")
  settingsJson Json?
  invoiceSeq   Int     @default(0) // per-garage gapless invoice counter
  jobSeq       Int     @default(0) // per-garage gapless Job Card No counter
  isPilot      Boolean @default(true) // pilots are NEVER charged (subscription billing)

  users        User[]
  customers    Customer[]
  bookings     Booking[]
  jobCards     JobCard[]
  invoices     Invoice[]
  parts        Part[]
  partRequests PartRequest[]
  reminders    Reminder[]
  bays         Bay[]
  ledgerEntries LedgerEntry[]
  aiEvents     AiEvent[]
  subscription Subscription?
  whatsAppAccount WhatsAppAccount?
  waThreads    WhatsAppThread[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Subscription billing (Plan B) ----------
enum SubStatus {
  PILOT
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Plan {
  id           String   @id @default(cuid())
  code         String   @unique // STARTER | GROWTH | PRO
  name         String
  priceMonthly Decimal  @db.Decimal(12, 2) // plan prices live in the DB
  currency     String   @default("AED")
  stripePriceId String?
  active        Boolean @default(true)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id                   String    @id @default(cuid())
  garageId             String    @unique
  garage               Garage    @relation(fields: [garageId], references: [id])
  planId               String?
  plan                 Plan?     @relation(fields: [planId], references: [id])
  status               SubStatus @default(PILOT)
  stripeCustomerId     String? // never store raw card data — only gateway ids
  stripeSubscriptionId String?
  trialEnd             DateTime?
  currentPeriodEnd     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Idempotent webhook log (dedupe on the gateway event id).
model BillingEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  payloadJson   Json?
  createdAt     DateTime @default(now())
}

// Staff only — has login. Customers are NOT here.
model User {
  id       String @id @default(cuid())
  garageId String
  garage   Garage @relation(fields: [garageId], references: [id])
  role         Role
  name         String
  phone        String?
  email        String  @unique // staff log in with email
  passwordHash String? // bcrypt; null = not yet set (e.g. OAuth later)
  lang         Lang    @default(en)

  advisorJobCards JobCard[] @relation("AdvisorJobCards")
  techSteps       JobStep[] @relation("TechSteps")
  partRequests    PartRequest[] @relation("PartRequestedBy")
  helperOf        JobHelper[] @relation("TechHelp")
  findings        JobFinding[] @relation("TechFindings")
  jobPartsCreated JobPart[] @relation("CreatedJobParts")
  qcJobs          JobCard[] @relation("QcJobs")
  deliveredJobs   JobCard[] @relation("DeliveredJobs")
  aiEvents        AiEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([garageId])
}

// Passwordless, phone-keyed. Created on first WhatsApp contact. Never logs in.
model Customer {
  id       String @id @default(cuid())
  garageId String
  garage   Garage @relation(fields: [garageId], references: [id])
  name     String
  phone    String
  email    String? // optional, captured at reception
  lang     Lang   @default(ar)
  trn      String? // for B2B invoices
  waId     String? // WhatsApp id

  vehicles  Vehicle[]
  bookings  Booking[]
  waThreads WhatsAppThread[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([garageId, phone])
  @@index([garageId])
}

model Vehicle {
  id           String  @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  make         String
  model        String
  year         Int?
  plate        String
  vin          String?

  jobCards JobCard[]
  bookings Booking[]
  reminders Reminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

// ---------- Intake (propose-confirm lives here, BEFORE a JobCard) ----------
model Booking {
  id             String         @id @default(cuid())
  garageId       String
  garage         Garage         @relation(fields: [garageId], references: [id])
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id])
  vehicleId      String?
  vehicle        Vehicle?       @relation(fields: [vehicleId], references: [id])
  channel        BookingChannel
  rawText        String?
  voiceNoteUrl   String?
  photoUrls      String[]
  aiProposalJson Json?
  status         BookingStatus  @default(PROPOSED)
  jobCard        JobCard?       @relation("BookingJobCard")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([garageId, status])
}

// ---------- The spine ----------
model JobCard {
  id        String    @id @default(cuid())
  garageId  String
  garage    Garage    @relation(fields: [garageId], references: [id])
  vehicleId String
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id])
  advisorId String?
  advisor   User?     @relation("AdvisorJobCards", fields: [advisorId], references: [id])
  bookingId String?   @unique
  booking   Booking?  @relation("BookingJobCard", fields: [bookingId], references: [id])
  status    JobStatus @default(ARRIVED)
  heldFrom  JobStatus?   // stage to resume to after ON_HOLD
  holdReason HoldReason? // why it's on hold
  holdNote   String?
  assignedToId String?   // advisor pre-assignment to a specific tech (optional)
  claimedById  String?   // technician who claimed it (PRIMARY) — the atomic claim lock (null = in pool)
  claimedAt    DateTime? // start of the diagnosis-duration window
  sentForEstimateAt DateTime? // when the tech tapped 'Send for Estimate' — end of diagnosis window, start of pricing window
  priority     Int       @default(0) // queue urgency: 0 normal, 1 urgent, 2 emergency
  bayId        String?   // physical bay/ramp this car occupies (Tier 2 #7)
  bay          Bay?      @relation(fields: [bayId], references: [id])

  // ----- Reception (Job-Card-Data-Model.md) — captured at intake by the advisor -----
  number            Int?       // gapless per-garage Job Card No, rendered JC-2026-0001
  mileageIn         Int?       // odometer at arrival
  oilType           OilType    @default(NONE) // feeds maintenance reminders
  fuelLevel         FuelLevel? // Empty/¼/½/¾/Full
  complaint         String?    // customer complaint(s)
  exteriorCondition String[]   // checkbox values (NO_DAMAGE, SCRATCHES, ...)
  exteriorRemarks   String?
  interiorCondition String[]   // checkbox values (CLEAN, DIRTY, WARNING_LIGHT, OTHER)
  interiorRemarks   String?
  valuables         String[]   // checkbox values (NONE, DOCUMENTS, CASH, ...)
  valuablesNote     String?
  moulkiaConsentAt  DateTime?  // compliance: consent recorded at intake
  // ----- Repair stage (technician records actual work) -----
  workNotes         String?    // work-completed notes
  workCompletedAt   DateTime?  // alias for spec's `completedAt` — set when the tech taps 'Mark complete' (Stage 7→8)
  // ----- Invoice send (Stage 8) -----
  invoiceSentAt     DateTime?  // set when the cashier taps 'Send invoice to customer'
  // ----- Quality Control -----
  qcChecks          String[]   // checkbox values (REPAIR_COMPLETED, ROAD_TEST, ...)
  qcById            String?    // QC inspector
  qcBy              User?      @relation("QcJobs", fields: [qcById], references: [id])
  qcAt              DateTime?  // sign-off time
  // ----- Delivery (Job-Card-Data-Model.md) -----
  mileageOut          Int?
  deliveredById       String?
  deliveredBy         User?     @relation("DeliveredJobs", fields: [deliveredById], references: [id])
  deliveredAt         DateTime?
  deliveryConfirmedAt DateTime? // customer collection record (WhatsApp confirm = signature equivalent)

  steps         JobStep[]
  estimates     Estimate[]
  invoices      Invoice[]
  partMovements PartMovement[]
  partRequests  PartRequest[]
  reminders     Reminder[]
  helpers       JobHelper[]
  finding       JobFinding?
  jobParts      JobPart[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([garageId, number])
  @@index([garageId, status])
}

model JobStep {
  id           String  @id @default(cuid())
  jobCardId    String
  jobCard      JobCard @relation(fields: [jobCardId], references: [id])
  type         String
  photoUrl     String?
  voiceNoteUrl String?
  transcript   String?
  techId       String?
  tech         User?   @relation("TechSteps", fields: [techId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobCardId])
}

// Technician Findings (Job-Card-Data-Model.md) — one per job; submittedAt marks the
// hand-off to the cashier (job advances to ESTIMATE).
model JobFinding {
  id          String   @id @default(cuid())
  jobCardId   String   @unique
  jobCard     JobCard  @relation(fields: [jobCardId], references: [id])
  techId      String?
  tech        User?    @relation("TechFindings", fields: [techId], references: [id])
  findings    String?
  diagnosis   String?
  submittedAt DateTime? // set when submitted to the cashier

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Technician parts list (REQUIRED at diagnosis; USED later). Free-text part No /
// description + optional catalog link. No price — pricing is the cashier's.
model JobPart {
  id          String      @id @default(cuid())
  jobCardId   String
  jobCard     JobCard     @relation(fields: [jobCardId], references: [id])
  kind        JobPartKind @default(REQUIRED)
  partId      String?     // optional catalog link
  part        Part?       @relation(fields: [partId], references: [id])
  partNo      String?
  description String
  qty         Int         @default(1)
  createdById String?
  createdBy   User?       @relation("CreatedJobParts", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([jobCardId, kind])
}

// ---------- Estimate / Invoice / Payment ----------
model Estimate {
  id        String         @id @default(cuid())
  jobCardId String
  jobCard   JobCard        @relation(fields: [jobCardId], references: [id])
  subtotal  Decimal        @db.Decimal(12, 2)
  vatAmount Decimal        @db.Decimal(12, 2)
  total     Decimal        @db.Decimal(12, 2)
  status    EstimateStatus @default(DRAFT)
  sentAt         DateTime? // when the cashier flipped status to SENT (pricing-duration end)
  approvedAt     DateTime? // audit: when the customer approved (dispute shield)
  approvedAmount Decimal?  @db.Decimal(12, 2)

  lines   EstimateLine[]
  invoice Invoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobCardId])
}

model EstimateLine {
  id          String   @id @default(cuid())
  estimateId  String
  estimate    Estimate @relation(fields: [estimateId], references: [id])
  kind        LineKind
  partId      String?
  part        Part?    @relation(fields: [partId], references: [id])
  description String
  qty         Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)
  vatRate     Decimal  @default(0.05) @db.Decimal(5, 4)
  declined    Boolean  @default(false) // customer chose to skip this item

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estimateId])
}

model Invoice {
  id              String          @id @default(cuid())
  garageId        String
  garage          Garage          @relation(fields: [garageId], references: [id])
  jobCardId       String
  jobCard         JobCard         @relation(fields: [jobCardId], references: [id])
  estimateId      String?         @unique
  estimate        Estimate?       @relation(fields: [estimateId], references: [id])
  number          Int // per-garage gapless sequence
  customerTrn     String?
  issuedAt        DateTime        @default(now())
  dueDate         DateTime
  subtotal        Decimal         @db.Decimal(12, 2)
  vatAmount       Decimal         @db.Decimal(12, 2)
  total           Decimal         @db.Decimal(12, 2)
  qrPayload       String? // KSA hook — exists day one
  status          InvoiceStatus   @default(DRAFT)
  clearanceStatus ClearanceStatus @default(NA) // KSA hook

  lines    InvoiceLine[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([garageId, number]) // VAT: gapless, per-garage numbering
  @@index([garageId, status])
}

// SNAPSHOT — invoice is a legal doc; never re-reads the estimate.
model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  kind        LineKind
  description String
  qty         Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)
  vatRate     Decimal  @default(0.05) @db.Decimal(5, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  amount    Decimal  @db.Decimal(12, 2)
  method    String
  paidAt    DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
}

// ---------- Inventory ----------
model Part {
  id        String @id @default(cuid())
  garageId  String
  garage    Garage @relation(fields: [garageId], references: [id])
  sku       String
  name      String
  qtyOnHand Int    @default(0)
  cost      Decimal @db.Decimal(12, 2)
  price     Decimal @db.Decimal(12, 2)

  movements     PartMovement[]
  estimateLines EstimateLine[]
  partRequests  PartRequest[]
  jobParts      JobPart[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([garageId, sku])
}

model PartMovement {
  id        String   @id @default(cuid())
  partId    String
  part      Part     @relation(fields: [partId], references: [id])
  jobCardId String?
  jobCard   JobCard? @relation(fields: [jobCardId], references: [id])
  delta     Int
  reason    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partId])
}

// Tier 1 #3 — the part-request loop. A technician asks for a part; the advisor /
// parts person fulfills (in stock) or orders (out of stock → job auto-pauses).
model PartRequest {
  id            String            @id @default(cuid())
  garageId      String
  garage        Garage            @relation(fields: [garageId], references: [id])
  jobCardId     String
  jobCard       JobCard           @relation(fields: [jobCardId], references: [id])
  partId        String?           // catalog part, if known
  part          Part?             @relation(fields: [partId], references: [id])
  description   String            // free-text (used when no catalog part)
  qty           Int               @default(1)
  status        PartRequestStatus @default(REQUESTED)
  requestedById String?           // the technician who asked
  requestedBy   User?             @relation("PartRequestedBy", fields: [requestedById], references: [id])
  note          String?           // advisor note (e.g. supplier, ETA)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([garageId, status])
  @@index([jobCardId])
}

// Tier 2 #4 — additional technicians (helpers) on one car, alongside the primary
// claimer. Helpers may log work; the claimer keeps the claim/release.
model JobHelper {
  id        String  @id @default(cuid())
  jobCardId String
  jobCard   JobCard @relation(fields: [jobCardId], references: [id])
  techId    String
  tech      User    @relation("TechHelp", fields: [techId], references: [id])

  createdAt DateTime @default(now())

  @@unique([jobCardId, techId])
  @@index([techId])
}

// Tier 2 #7 — bays/ramps as a limited physical resource. A car may occupy one bay.
model Bay {
  id       String @id @default(cuid())
  garageId String
  garage   Garage @relation(fields: [garageId], references: [id])
  name     String

  jobCards JobCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([garageId, name])
}

// Workflow-Spec step 16 — automated maintenance reminders. Scheduled when a job
// completes; auto-sent (routine) when due. dueAt = serviceDate + per-type interval.
model Reminder {
  id          String         @id @default(cuid())
  garageId    String
  garage      Garage         @relation(fields: [garageId], references: [id])
  vehicleId   String
  vehicle     Vehicle        @relation(fields: [vehicleId], references: [id])
  jobCardId   String?        // the service that triggered it
  jobCard     JobCard?       @relation(fields: [jobCardId], references: [id])
  type        ReminderType
  serviceDate DateTime       // when the service was performed
  dueAt       DateTime       // when to remind (serviceDate + interval)
  status      ReminderStatus @default(SCHEDULED)
  sentAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([garageId, status, dueAt])
  @@index([vehicleId])
}

// ---------- Zero-entry accounting (rows generated by services only) ----------
model LedgerEntry {
  id         String  @id @default(cuid())
  garageId   String
  garage     Garage  @relation(fields: [garageId], references: [id])
  account    String
  debit      Decimal @default(0) @db.Decimal(12, 2)
  credit     Decimal @default(0) @db.Decimal(12, 2)
  sourceType String
  sourceId   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([garageId, account])
}

// ---------- WhatsApp ----------
// Per-garage WhatsApp Business connection (Embedded Signup). Token stored ENCRYPTED.
model WhatsAppAccount {
  id             String   @id @default(cuid())
  garageId       String   @unique
  garage         Garage   @relation(fields: [garageId], references: [id])
  wabaId         String?
  phoneNumberId  String?  @unique
  phoneNumber    String?
  accessTokenEnc String? // AES-GCM ciphertext — never plaintext, never a raw token
  status         WaConnStatus @default(DISCONNECTED)
  connectedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WhatsAppThread {
  id               String          @id @default(cuid())
  garageId         String
  garage           Garage          @relation(fields: [garageId], references: [id])
  customerId       String
  customer         Customer        @relation(fields: [customerId], references: [id])
  waId             String
  mode             WaMode          @default(BOT) // BOT = AI handles; HUMAN = advisor took over
  threadStatus     WaThreadStatus  @default(OPEN)
  assignedAdvisorId String?
  lastMessageAt    DateTime?

  messages WhatsAppMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([garageId, waId])
}

model WhatsAppMessage {
  id          String         @id @default(cuid())
  threadId    String
  thread      WhatsAppThread @relation(fields: [threadId], references: [id])
  direction   WaDirection
  template    String?
  body        String?
  waMessageId String         @unique // webhook idempotency
  status      String?
  aiGenerated Boolean        @default(false)
  state       WaMsgState     @default(SENT) // RECEIVED | SENT | PENDING_APPROVAL | DRAFT
  payloadJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([threadId])
}

// ---------- AI usage metering (the margin trap) ----------
model AiEvent {
  id           String  @id @default(cuid())
  garageId     String
  garage       Garage  @relation(fields: [garageId], references: [id])
  userId       String?
  user         User?   @relation(fields: [userId], references: [id])
  kind         AiKind
  model        String // Opus vs Haiku is the biggest cost lever
  sourceType   String?
  sourceId     String?
  tokensIn     Int
  tokensOut    Int
  costEstimate Decimal @db.Decimal(12, 6)
  latencyMs    Int?

  createdAt DateTime @default(now())

  @@index([garageId, kind])
}
