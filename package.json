{
  "name": "garageos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "DATABASE_URL=\"$DIRECT_URL\" prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "check:pii-urls": "node scripts/check-pii-in-urls.mjs",
    "db:preflight": "node scripts/db-preflight.mjs",
    "pretest": "node scripts/db-preflight.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:init": "prisma dev --name garageos --detach",
    "db:dev": "node scripts/db-dev.mjs",
    "db:doctor": "node scripts/db-doctor.mjs",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "smoke": "playwright test",
    "smoke:headed": "playwright test --headed",
    "smoke:report": "playwright show-report"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sparticuz/chromium": "^149.0.0",
    "@supabase/storage-js": "^2.107.0",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.24.0",
    "next": "16.2.7",
    "next-auth": "^5.0.0-beta.31",
    "puppeteer-core": "^25.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
