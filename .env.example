# GarageOS — environment template. Copy to `.env` and fill in. NEVER commit real secrets.

# --- Database ---
# LOCAL DEV (free, no signup): run `npx prisma dev --name garageos` and copy the
# DATABASE_URL / SHADOW_DATABASE_URL it prints (ports are dynamic).
#
# DEPLOY (free tier): create a project at https://supabase.com, then Connect >
# "Session pooler" (port 5432) connection string. SSL is handled in code
# (src/lib/pg-adapter.ts) — do NOT append ?sslmode=require (the pg driver then
# enforces strict verify-full and rejects Supabase's self-signed pooler chain).
# Migrations use `prisma migrate deploy` (no shadow DB needed), so SHADOW_DATABASE_URL
# is only for the local Prisma Postgres dev server.
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres"
# SHADOW_DATABASE_URL=  # local dev only (from `npx prisma dev`)

# --- Auth.js (NextAuth v5) — added in Build Step 2 ---
# AUTH_SECRET="generate with: npx auth secret"

# --- Anthropic (AI) — Build Step 7+ ---
# ANTHROPIC_API_KEY="sk-ant-..."

# --- WhatsApp Business Cloud API (Meta) — Build Step 6 ---
# Without these, WhatsApp runs in MOCK mode (records messages, shows links in-app).
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_VERIFY_TOKEN=""
# APP_URL="http://localhost:3000"   # base URL used in customer links (set to your deploy URL)

# --- Object storage (Supabase Storage) — for photos & voice notes ---
# Without these, uploads fall back to LOCAL DISK (./.uploads + /api/files/[name]).
# Local works in dev / demo but breaks on Vercel (read-only filesystem). To enable
# Supabase Storage:
#   1) In your Supabase project: Storage > New bucket > name "garage-uploads"
#      > Public: OFF (we use signed URLs, valid 7 days).
#   2) Settings > API > copy "service_role" key (server-only — NEVER ship to the browser).
#   3) Set both env vars below.
# SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."
# STORAGE_BUCKET="garage-uploads"  # optional override (default: garage-uploads)

# --- Subscription billing ---
# MANUAL during the pilot — no Stripe, no keys. Garages stay on Garage.isPilot (not charged);
# GarageOS sets plans up by hand for the first ~30 garages. (Stripe can be added later.)

# Dev-only role-bypass. Set to 1 in local .env to enable /dev/login?role=CASHIER
# (and similar) for OWNER/ADVISOR/TECH/CASHIER. Double-gated by NODE_ENV — has no
# effect on Vercel even if set there.
# DEV_AUTH_BYPASS=1
