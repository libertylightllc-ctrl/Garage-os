# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local agent settings (personal, not shared)
.claude/settings.local.json

# dev file uploads (photos / voice notes)
.uploads/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# loose credential / secret files — NEVER commit (kept out of the repo entirely)
garageos-backup keys.txt
*keys*.txt
*secret*.txt

# local debug / live-deploy probe artifacts (curl outputs, cookie jars, scrapes)
.cookies-*.txt
.cookies-*.json
.tiny.png
.realish.*
.booking-*.txt
.booking-*.html
.scan-*.txt
.scan-*.html
.confirm-*.html
.upload-*.html
.owner.html
.advisor.html
.cashier.html
.tech.html
.events.json
.vercel-env-tmp.json
.iphone-sized.jpg
.t*.html
.p*.html
.est*.html
.o_*.html
.a_*.html
.c_*.html
.b*.html
.br.html
.x.html
.chat.html
.inv.html
.signup.html
.login.html
.wap.html
.job*.html
.ttest.html
.scan-*.html

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

.vercel
backups/

# Local-only scratch: agent workspace, ad-hoc diffs, one-off helper output.
# Never gets committed. If a file here is worth keeping, move it under
# scripts/ or docs/.
scratchpad/
diff.txt

# Playwright — auth cookies + reports are per-run, never committed
.auth/
playwright-report/
test-results/
