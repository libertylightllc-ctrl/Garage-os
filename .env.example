# GarageOS — environment template. Copy to `.env` and fill in. NEVER commit real secrets.

# --- Database ---
# LOCAL DEV (free, no signup): run `npx prisma dev --name garageos` and copy the
# DATABASE_URL / SHADOW_DATABASE_URL it prints (ports are dynamic).
#
# DEPLOY (free tier): create a project at https://supabase.com (pick an EU region for
# the data-residency note), then Project Settings > Database > Connection string.
#   - DATABASE_URL  = the "Transaction" pooler URL (port 6543), add ?pgbouncer=true
#   - DIRECT_URL    = the "Session"/direct URL (port 5432) for migrations
DATABASE_URL="postgres://USER:PASSWORD@HOST:PORT/DB?sslmode=require"
SHADOW_DATABASE_URL="postgres://USER:PASSWORD@HOST:PORT/DB_shadow?sslmode=require"

# --- Auth.js (NextAuth v5) — added in Build Step 2 ---
# AUTH_SECRET="generate with: npx auth secret"

# --- Anthropic (AI) — Build Step 7+ ---
# ANTHROPIC_API_KEY="sk-ant-..."

# --- WhatsApp Business Cloud API (Meta) — Build Step 6 ---
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_VERIFY_TOKEN=""

# --- Object storage (Supabase Storage / S3) — for photos & voice notes ---
# STORAGE_BUCKET="garageos-media"
