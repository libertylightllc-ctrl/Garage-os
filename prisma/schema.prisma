// GarageOS — Phase 1 MVP schema (UAE-only). See docs/GarageOS-Technical-Spec.md §2.
// Money is ALWAYS Decimal, never Float. Staff = User (auth); Customer = passwordless.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7 moved connection URLs out of schema.prisma — url and
  // directUrl live in prisma.config.ts. Prisma reads DATABASE_URL and
  // DIRECT_URL from process.env via that config.
}

// ---------- Enums ----------
enum Role {
  OWNER
  ADVISOR
  TECH
  CASHIER
  MASTER
}

enum Lang {
  ar
  en
  hi
  ur
}

enum BookingChannel {
  WA
  WEB
  PHONE
}

enum BookingStatus {
  PROPOSED
  CONFIRMED
  REJECTED
}

enum HoldReason {
  AWAITING_PART
  AWAITING_CUSTOMER
  AWAITING_APPROVAL
  OTHER
}

enum JobStatus {
  ARRIVED
  INSPECTION
  ESTIMATE
  APPROVED
  REPAIR
  EXTRA_WORK_AWAITING_APPROVAL // tech tapped 'Send for Re-estimate'; awaiting cashier+customer to bless the extra
  TECH_COMPLETE // tech tapped 'Mark complete'; awaiting cashier to finalise invoice
  INVOICED
  DELIVERED
  ON_HOLD
  CANCELLED
}

enum EstimateStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

// UAE emirate — used by Garage.emirate + Invoice.emirate (E4b,
// AR 2026-09-03) so the VAT summary produces Form 201's per-emirate
// seven-box breakdown. Values match FTA canonical spelling on
// tax.gov.ae; changing them means changing what the FTA import/export
// pipeline expects, so pin these before adding a country enum.
enum Emirate {
  AbuDhabi
  Dubai
  Sharjah
  Ajman
  UmmAlQuwain
  RasAlKhaimah
  Fujairah
}

enum ClearanceStatus {
  NA
  PENDING
  CLEARED
}

enum LineKind {
  LABOR
  PART
  FEE
  // SUBLET — outside work + shop consumables + services (brake oil
  // flushing, wheel alignment, injector cleaning, etc.). AR
  // 2026-08-25 Batch C. Additive enum value; existing PART/LABOR/FEE
  // rows untouched. Cost-aware like PART (has unitCost + markupPct)
  // but NEVER links to catalogue Part rows and NEVER auto-creates
  // POs — it's outsourced or consumed, not inventoried.
  SUBLET
}

enum WaConnStatus {
  CONNECTED
  DISCONNECTED
}

enum WaMode {
  BOT
  HUMAN
}

enum WaThreadStatus {
  OPEN
  NEEDS_HUMAN
  CLOSED
}

enum WaMsgState {
  RECEIVED
  SENT
  PENDING_APPROVAL
  DRAFT
}

enum WaDirection {
  IN
  OUT
}

enum AiKind {
  INTAKE
  COPILOT
  OCR
  RECEPTIONIST
}

// Part-request loop (Tier 1 #3). Open states (REQUESTED/ORDERED/ARRIVED) block the
// job; FULFILLED/CANCELLED close it. Out-of-stock requests auto-pause AWAITING_PART.
enum PartRequestStatus {
  REQUESTED
  ORDERED
  ARRIVED
  FULFILLED
  CANCELLED
}

// Inventory Phase 2 — purchasing. A purchase order is raised to a supplier
// (DRAFT), sent (ORDERED), then received (RECEIVED → stock increases, 2b),
// or CANCELLED. Distinct from PartRequestStatus (the technician job-side
// request loop) — this is the owner's stock-replenishment document.
// Author's intent when creating the document. Distinct from status
// (which tracks lifecycle). Only meaningful while status is DRAFT.
enum PurchaseOrderIntent {
  QUOTE // "Ask a supplier to price this" — RFQ, cost optional per line
  ORDER // "Place an order at these prices" — cost required per line
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED // some qty received, more still outstanding (2b partial receiving)
  RECEIVED
  CANCELLED
}

// Send audit log — see model PurchaseOrderSend for the full contract.
// Intentional omissions (do NOT add without a new commit + spec):
//   • no PRINT — print is local, has no recipient, no observable outcome.
//   • no DELIVERED — needs a Resend webhook; ships with the webhook, not before.
// Adding an enum value that nothing can produce is a trap.
enum PurchaseOrderSendChannel {
  WHATSAPP
  EMAIL
}

// Invoice send channel — mirrors PurchaseOrderSendChannel. Kept as its
// own enum (not shared) so a future channel (SMS?) can be added on one
// side without side-effects on the other. WHATSAPP today is a wa.me
// hand-off; when the Meta Cloud API lands the channel value doesn't
// change, only the status semantics do (HANDED_OFF → SENT after the
// API accepts).
enum InvoiceSendChannel {
  WHATSAPP
  EMAIL
}

// See PurchaseOrderSendStatus for the same shape. Present here as a
// parallel enum so InvoiceSend rows don't cross-reference a PO-scoped
// name.
enum InvoiceSendStatus {
  HANDED_OFF
  SENT
  FAILED
}

// HANDED_OFF (not "OPENED") is the WhatsApp shape: the wa.me intent left
// our hands, the outcome is unknown. "OPENED" would read like email
// open-tracking, which is the opposite. Every WHATSAPP row terminates at
// HANDED_OFF or FAILED (we can't observe more). Every EMAIL row goes
// HANDED_OFF (immediately, before we call Resend — for symmetry with the
// wa.me hand-off) then transitions to SENT once Resend accepts, or FAILED
// with an errorCode. DELIVERED is deliberately absent until the webhook
// commit lands.
enum PurchaseOrderSendStatus {
  HANDED_OFF
  SENT
  FAILED
}

// Snapshot of what the document WAS at send time. A PO/RFQ can be edited
// after sending (advisor adds a price, unpriced lines fill in); the audit
// row must still show "this went out as an RFQ" — that's the record that
// answers "did we already ask this supplier, and for what?"
enum PurchaseOrderDocumentKind {
  PO
  RFQ
}

// Inventory OCR import — a photographed supplier invoice, OCR'd into draft
// parts lines that the OWNER reviews + corrects before any catalog write.
// DRAFT = awaiting review; CONFIRMED = owner saved it to the catalog;
// DISCARDED = owner threw it away. Nothing hits the catalog until CONFIRMED.
enum PartsImportStatus {
  DRAFT
  CONFIRMED
  DISCARDED
}

// Maintenance reminders (Workflow-Spec step 16). Interval is date-based; the
// message asks the customer to check their own mileage.
enum ReminderType {
  OIL_5000
  OIL_10000
  BATTERY
  TIRE_ROTATION
  BRAKES
  AC_SERVICE
  AIR_FILTER
  COOLANT
  TRANSMISSION
}

enum ReminderStatus {
  SCHEDULED
  SENT
  CANCELLED
}

// Job-card Reception fields (Job-Card-Data-Model.md).
enum OilType {
  KM_5000
  KM_10000
  NONE
}

enum FuelLevel {
  EMPTY
  QUARTER
  HALF
  THREE_QUARTER
  FULL
}

// Technician parts list (Job-Card-Data-Model.md). REQUIRED = quoted at diagnosis;
// USED = actual at repair (USED handled in a later stage).
enum JobPartKind {
  REQUIRED
  USED
  EXTRA // tech added mid-job after the original estimate was already approved; rolled into a new estimate when 'Send for Approval' is tapped
}

// ---------- Tenancy ----------
model Garage {
  id                     String   @id @default(cuid())
  name                   String
  country                String   @default("UAE")
  // AR 2026-09-03 (E4b) — UAE emirate for Form 201's per-emirate
  // seven-box breakdown. Nullable during rollout: the operator
  // sets it via /settings once, then generateInvoiceAction snapshots
  // it onto Invoice.emirate at generation. See rule 14 for the
  // snapshot-vs-live-read discipline and the coverage-banner shape
  // for invoices missing an emirate. Only meaningful when
  // country="UAE"; multi-country expansion (Phase 2) may extend
  // the enum or split it per-country then.
  emirate                Emirate?
  trn                    String? // tax registration number (was vatNumber)
  branchOfId             String? // Phase-2 hook; Phase 1 is single-garage
  branchOf               Garage?  @relation("GarageBranches", fields: [branchOfId], references: [id])
  branches               Garage[] @relation("GarageBranches")
  settingsJson           Json?
  invoiceSeq             Int      @default(0) // per-garage gapless invoice counter
  jobSeq                 Int      @default(0) // per-garage gapless Job Card No counter
  billSeq                Int      @default(0) // per-garage gapless SupplierBill counter (Payables phase, AR 2026-08-30)
  isPilot                Boolean  @default(true) // pilots are NEVER charged (subscription billing)
  logoUrl                String? // garage-uploaded brand logo (Supabase public URL); null = use default GarageOS brand. Set via uploadGarageLogoAction; appears on dashboard nav + invoice + estimate + customer-facing links.
  // Shop-wide default markup applied to catalogue + cost-based estimate
  // lines (AR 2026-08-12). Null → advisor enters markup per line. Set
  // via Owner Settings → Pricing defaults. Only a hint at line-create
  // time — the per-line markupPct is what actually prices the line, so
  // an owner can change this later without disturbing existing estimates.
  defaultPartsMarkupPct  Decimal? @db.Decimal(5, 2)
  // Shop-wide default for the Payment Terms block printed on every
  // estimate (AR 2026-08-25 Batch C). Free text — most shops set one
  // boilerplate ("50% advance and 50% on delivery") and it applies
  // to every estimate. A per-estimate override lives on
  // Estimate.paymentTerms; renderer reads:
  //   estimate.paymentTerms ?? garage.defaultPaymentTerms ?? null
  // Both null → the block doesn't render. Set via Owner Settings.
  defaultPaymentTerms    String?
  // Shop-wide default hourly cost of labour (AR 2026-08-12, profit
  // reporting Phase 1, option B). Used to convert WorkSession minutes
  // into a labour-cost estimate for the profit calc on invoices +
  // owner reports. Null → labour profit cannot be calculated for that
  // job / period; the report renders it as "unknown" rather than
  // assuming zero (which would read as 100 % margin, which is worse
  // than "unknown"). Set via Owner Settings → Pricing defaults.
  //
  // Deliberately shop-wide, not per-tech. AR's decision: start with
  // one number for the shop (option B in the plan); a per-tech
  // override on User.hourlyCost is a later phase if it turns out
  // techs at DCM cost meaningfully different amounts.
  //
  // Snapshotted onto WorkSession at close so a later rate change
  // doesn't rewrite historical labour cost — same "frozen at emit"
  // discipline as Invoice.customerTrn.
  defaultLaborHourlyCost Decimal? @db.Decimal(12, 2)
  // Shop-wide Terms & Conditions — split by document type
  // (AR 2026-08-25). Same clauses rarely fit both:
  //   estimateTerms — printed at the bottom of every estimate.
  //     Typically forward-looking clauses (validity period, prices
  //     subject to change, additional-work approval).
  //   invoiceTerms — printed at the bottom of every invoice.
  //     Typically post-billing clauses (workmanship warranty, parts
  //     warranty pass-through, customer-supplied parts excluded,
  //     payment terms as agreed).
  //
  // Both free text, both nullable, both without ship-wording — the
  // block simply doesn't render when a shop has not saved terms.
  // A seven-clause sample prefills the Settings textarea on first
  // open (see settings page) so a shop is nudged to adopt or edit
  // rather than leave blank; the DB stays null until saved.
  //
  // Renamed from `terms` (Batch D) at split time — a shop shipping
  // an "estimate is valid for 7 days" clause at the bottom of a
  // paid invoice would embarrass them in front of the customer.
  estimateTerms          String?
  invoiceTerms           String?
  // Shop main contact number (AR 2026-08-25 Batch F1) — fallback for
  // the advisor phone snapshot on estimates + invoices when the
  // individual advisor's User.phone is null. A customer meant to
  // call back needs a working number; if the shop shares one line
  // that's still better than no number on the doc. Nullable; if
  // both this and User.phone are null, the advisor block prints
  // just the name.
  phone                  String?
  // ERPNext one-way push. Off by default; the tailer + client are inert
  // until this flag flips per garage. See ERPNEXT_SYNC_BRIEF.md §1
  // constraint 5 ("behind a per-garage flag, off by default") and
  // Phase 1 of §8. Nothing reads this yet — Phase 2 wires it into the
  // tailer's WHERE clause.
  erpSyncEnabled         Boolean  @default(false)
  // Payables (AR 2026-08-30). Off by default — no existing garage's
  // receivePurchaseOrderAction path changes. Per-garage rollout gate:
  // when true, a goods receipt auto-creates a SupplierBill and posts
  // DR Inventory + DR VAT-Input / CR AP inside the same tx as the
  // PartMovement writes. When false, receive is unchanged (same code
  // path as before this shipped). Same shape as erpSyncEnabled.
  payablesEnabled        Boolean  @default(false)
  // COGS at invoice (AR 2026-09-02, C4a). Off by default — no
  // existing garage's generateInvoiceAction path changes. When
  // true, the invoice ledger post additionally writes DR COGS /
  // CR Inventory for SUM(PART qty × unitCost) from the frozen
  // InvoiceLine snapshots, all-or-nothing per invoice (any null
  // unitCost → skip the whole COGS post). Void reverses the pair
  // when it exists. Enables the P&L (E3) to read parts-cost from
  // the ledger. Same rollout shape as payablesEnabled — prove on
  // Demo Garage first, then flip per-garage.
  cogsEnabled            Boolean  @default(false)
  // Shop-wide fallback for cold-start outbound customer messages
  // (AR 2026-08-19). Null = the shop hasn't set one; the resolver
  // falls through to "en" as last resort. UAE default was Arabic
  // by fiat; making it a per-shop opt-in stops that assertion.
  defaultLang            Lang?
  // Free-text address printed on tax invoices + estimates (AR
  // 2026-08-19, Batch B — UAE FTA Art. 59 requires the supplier's
  // address on every tax invoice). Multi-line rendered as-is via
  // whitespace-pre-line on DocumentHeader.
  address                String?
  // Per-garage VAT rate as a stored 4-dp decimal (0.05 = 5 %).
  // Column added with a UAE-default so Phase 2 (multi-country) can
  // plug KSA in at 0.15 without a schema change against tables that
  // by then carry live invoice history. Editable from Settings is
  // deliberately NOT wired in Batch B — the UI shows "5% (UAE FTA)"
  // read-only because UAE VAT is a legal constant, not a shop
  // preference. `totalsFor` / VAT strategies still read the module
  // constant today; the field switches on when multi-country lands.
  vatRate                Decimal? @default(0.05) @db.Decimal(5, 4)

  users              User[]
  customers          Customer[]
  bookings           Booking[]
  jobCards           JobCard[]
  invoices           Invoice[]
  parts              Part[]
  suppliers          Supplier[]
  purchaseOrders     PurchaseOrder[]
  purchaseOrderSends PurchaseOrderSend[]
  invoiceSends       InvoiceSend[]
  partMovements      PartMovement[]
  partsImports       PartsImport[]
  partRequests       PartRequest[]
  reminders          Reminder[]
  bays               Bay[]
  ledgerEntries      LedgerEntry[]
  advancePayments    AdvancePayment[]
  supplierBills      SupplierBill[]
  ledgerImportBatches LedgerImportBatch[]
  supplierPayments   SupplierPayment[]
  expenses           Expense[]
  aiEvents           AiEvent[]
  subscription       Subscription?
  whatsAppAccount    WhatsAppAccount?
  waThreads          WhatsAppThread[]
  intakeDrafts       IntakeDraft[]
  // ERPNext one-way push back-relations. Inert until Garage.erpSyncEnabled flips.
  erpEntityMaps      ErpEntityMap[]
  erpSyncJobs        ErpSyncJob[]
  erpSyncCursor      ErpSyncCursor?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Subscription billing (Plan B) ----------
enum SubStatus {
  PILOT
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Plan {
  id            String  @id @default(cuid())
  code          String  @unique // STARTER | GROWTH | PRO
  name          String
  priceMonthly  Decimal @db.Decimal(12, 2) // plan prices live in the DB
  currency      String  @default("AED")
  stripePriceId String?
  active        Boolean @default(true)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id                   String    @id @default(cuid())
  garageId             String    @unique
  garage               Garage    @relation(fields: [garageId], references: [id])
  planId               String?
  plan                 Plan?     @relation(fields: [planId], references: [id])
  status               SubStatus @default(PILOT)
  stripeCustomerId     String? // never store raw card data — only gateway ids
  stripeSubscriptionId String?
  trialEnd             DateTime?
  currentPeriodEnd     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Idempotent webhook log (dedupe on the gateway event id).
model BillingEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  payloadJson   Json?
  createdAt     DateTime @default(now())
}

// Staff only — has login. Customers are NOT here.
model User {
  id           String  @id @default(cuid())
  garageId     String
  garage       Garage  @relation(fields: [garageId], references: [id])
  role         Role
  name         String
  phone        String?
  email        String  @unique // staff log in with email
  passwordHash String? // bcrypt; null = not yet set (e.g. OAuth later)
  lang         Lang    @default(en)

  advisorJobCards      JobCard[]                  @relation("AdvisorJobCards")
  techSteps            JobStep[]                  @relation("TechSteps")
  partRequests         PartRequest[]              @relation("PartRequestedBy")
  helperOf             JobHelper[]                @relation("TechHelp")
  findings             JobFinding[]               @relation("TechFindings")
  jobPartsCreated      JobPart[]                  @relation("CreatedJobParts")
  partsImports         PartsImport[]              @relation("PartsImportedBy")
  qcJobs               JobCard[]                  @relation("QcJobs")
  deliveredJobs        JobCard[]                  @relation("DeliveredJobs")
  aiEvents             AiEvent[]
  workSessions         WorkSession[]              @relation("TechWorkSessions")
  purchaseOrderSends   PurchaseOrderSend[]        @relation("PurchaseOrderSentBy")
  invoiceSends         InvoiceSend[]              @relation("InvoiceSentBy")
  voidedInvoices       Invoice[]                  @relation("InvoiceVoidedBy")
  cancelledJobs        JobCard[]                  @relation("JobCancelledBy")
  heldJobs             JobCard[]                  @relation("JobHeldBy")
  // Slice 3 audits — separate named relations so the User row can be
  // referenced from any of the three roles on an intake collision:
  // attached / released a plate history row, or performed an
  // ownership transfer. Nullable on the plate side because the
  // backfill runs without a user context.
  plateHistoryAttached VehiclePlateHistory[]      @relation("PlateHistoryAttachedBy")
  plateHistoryReleased VehiclePlateHistory[]      @relation("PlateHistoryReleasedBy")
  ownershipTransfers   VehicleOwnershipTransfer[] @relation("OwnershipTransferBy")
  intakeDraftsCreated  IntakeDraft[]              @relation("IntakeDraftCreatedBy")
  ledgerImportsUploaded  LedgerImportBatch[]      @relation("LedgerImportBatchUploader")
  ledgerImportsCommitted LedgerImportBatch[]      @relation("LedgerImportBatchCommitter")

  // Last successful sign-in for this staff user. Written by the
  // baseProvider in src/auth.ts on every authorize() pass — best-effort,
  // never blocks sign-in if it fails. Used by the admin per-shop detail
  // page (Phase 3) to flag accounts that have gone quiet.
  lastLoginAt DateTime?

  // Brute-force lockout, mirroring AdminUser. failedLogins counts
  // consecutive wrong-password attempts; once it crosses the threshold
  // (src/lib/login-lockout.ts) lockedUntil is set to now + cooldown and
  // sign-in is refused until it passes. Reset to 0 / null on any
  // successful sign-in.
  failedLogins Int       @default(0)
  lockedUntil  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([garageId])
}

// Passwordless, phone-keyed. Created on first WhatsApp contact. Never logs in.
model Customer {
  id               String  @id @default(cuid())
  garageId         String
  garage           Garage  @relation(fields: [garageId], references: [id])
  name             String
  phone            String
  email            String? // optional, captured at reception
  // Nullable + no default (AR 2026-08-19). Previous @default(ar)
  // populated every prod row with "ar" regardless of whether the
  // customer had ever indicated Arabic — a fabricated value that
  // then drove wrong-language outbound sends. Null = "unknown, no
  // signal yet"; resolveCustomerLangForOutbound falls back to
  // Garage.defaultLang, then "en".
  lang             Lang?
  trn              String? // for B2B invoices
  waId             String? // WhatsApp id
  // AR 2026-08-23. Set on write when the input phone couldn't be
  // resolved to an E.164 shape wa.me would accept — a real-looking
  // but unusable number ("call at 5pm", a landline typed as a
  // 6-digit local, a foreign shape with no country code, etc). The
  // send path degrades to the WhatsApp contact picker so the doc
  // still goes out; this flag lets the customer detail page surface
  // WHY, so an advisor can fix the record on next contact. See
  // src/lib/normalize.ts `normalizeCustomerPhoneForWrite` for the
  // four write paths that set it.
  phoneNeedsReview Boolean @default(false)

  vehicles               Vehicle[]
  bookings               Booking[]
  waThreads              WhatsAppThread[]
  // Slice 3 — ownership-transfer audit rows reference the customer on
  // both sides of the transfer (previous / new owner) so both need
  // named relations. Neither side is authoritative; the Vehicle's
  // current `customerId` is the source of truth for "who owns this
  // now."
  ownershipTransfersFrom VehicleOwnershipTransfer[] @relation("OwnershipTransferFrom")
  ownershipTransfersTo   VehicleOwnershipTransfer[] @relation("OwnershipTransferTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([garageId, phone])
  @@index([garageId])
}

model Vehicle {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  make       String
  model      String
  year       Int?
  plate      String
  vin        String?
  // Intrinsic vehicle spec — used to render "Toyota Prado 2014 · 2.7 · Petrol"
  // on the technician job screen and next to each part request so the parts
  // supplier knows exactly which part fits. engineSize is free-text (NHTSA
  // returns decimal liters but advisors may type "2.0T" / "5.7L HEMI" / etc.)
  engineSize String?
  fuelType   String? // PETROL | DIESEL | HYBRID | ELECTRIC | OTHER

  jobCards           JobCard[]
  bookings           Booking[]
  reminders          Reminder[]
  poLines            PurchaseOrderLine[]
  // Slice 3 additions — see VehiclePlateHistory / VehicleOwnershipTransfer
  // at the bottom of this file for why these are separate tables and not
  // JSON columns on Vehicle.
  plateHistory       VehiclePlateHistory[]
  ownershipTransfers VehicleOwnershipTransfer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

// ---------- Intake (propose-confirm lives here, BEFORE a JobCard) ----------
model Booking {
  id             String         @id @default(cuid())
  garageId       String
  garage         Garage         @relation(fields: [garageId], references: [id])
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id])
  vehicleId      String?
  vehicle        Vehicle?       @relation(fields: [vehicleId], references: [id])
  channel        BookingChannel
  rawText        String?
  voiceNoteUrl   String?
  photoUrls      String[]
  aiProposalJson Json?
  status         BookingStatus  @default(PROPOSED)
  jobCard        JobCard?       @relation("BookingJobCard")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([garageId, status])
}

// ---------- The spine ----------
model JobCard {
  id                  String      @id @default(cuid())
  garageId            String
  garage              Garage      @relation(fields: [garageId], references: [id])
  vehicleId           String
  vehicle             Vehicle     @relation(fields: [vehicleId], references: [id])
  advisorId           String?
  advisor             User?       @relation("AdvisorJobCards", fields: [advisorId], references: [id])
  bookingId           String?     @unique
  booking             Booking?    @relation("BookingJobCard", fields: [bookingId], references: [id])
  status              JobStatus   @default(ARRIVED)
  heldFrom            JobStatus? // stage to resume to after ON_HOLD
  holdReason          HoldReason? // why it's on hold
  holdNote            String?
  // AR 2026-08-29 — hold audit. Every OTHER lifecycle state
  // transition on this model has some form of timestamp + actor
  // pair; hold had heldFrom + holdReason + holdNote but NO
  // heldAt (when) and NO heldByUserId (who). "Why is this job
  // on hold" was answerable via holdReason; "when did it go
  // on hold and who paused it" wasn't. Both nullable — holds
  // recorded before the 20260829010000_jobcard_held_audit
  // migration have both fields null, per docs/business-rules.md.
  //
  // Fidelity note: if a job cycles hold → resume → hold, these
  // columns record the LATEST hold only. Same limitation the
  // existing holdReason/holdNote columns have today.
  heldAt              DateTime?
  heldByUserId        String?
  heldBy              User?      @relation("JobHeldBy", fields: [heldByUserId], references: [id])
  assignedToId        String? // advisor pre-assignment to a specific tech (optional)
  claimedById         String? // technician who claimed it (PRIMARY) — the atomic claim lock (null = in pool)
  claimedAt           DateTime? // start of the diagnosis-duration window
  sentForEstimateAt   DateTime? // when the tech tapped 'Send for Estimate' — end of diagnosis window, start of pricing window
  sentForReestimateAt DateTime? // when the tech tapped 'Send for Re-estimate' (extra work found mid-job)
  priority            Int         @default(0) // queue urgency: 0 normal, 1 urgent, 2 emergency
  bayId               String? // physical bay/ramp this car occupies (Tier 2 #7)
  bay                 Bay?        @relation(fields: [bayId], references: [id])

  // ----- Reception (Job-Card-Data-Model.md) — captured at intake by the advisor -----
  number              Int? // gapless per-garage Job Card No, rendered JC-2026-0001
  mileageIn           Int? // odometer at arrival
  oilType             OilType    @default(NONE) // kept for future maintenance-reminder spec; UI temporarily hidden
  fuelType            String? // PETROL | DIESEL | HYBRID | ELECTRIC | OTHER — also auto-filled from NHTSA VIN decode
  fuelLevel           FuelLevel? // Empty/¼/½/¾/Full
  complaint           String? // customer complaint(s)
  exteriorCondition   String[] // checkbox values (NO_DAMAGE, SCRATCHES, ...)
  exteriorRemarks     String?
  interiorCondition   String[] // checkbox values (CLEAN, DIRTY, WARNING_LIGHT, OTHER)
  interiorRemarks     String?
  valuables           String[] // checkbox values (NONE, DOCUMENTS, CASH, ...)
  valuablesNote       String?
  moulkiaConsentAt    DateTime? // compliance: consent recorded at intake
  // ----- Repair stage (technician records actual work) -----
  workNotes           String? // work-completed notes
  workCompletedAt     DateTime? // alias for spec's `completedAt` — set when the tech taps 'Mark complete' (Stage 7→8)
  // ----- Invoice send (Stage 8) -----
  invoiceSentAt       DateTime? // set when the cashier taps 'Send via WhatsApp' — HANDED OFF to the operator's WhatsApp, NOT confirmed delivery
  // Set only when we KNOW the invoice reached the customer. In the
  // wa.me era (2026-08-09 → …) this stays null forever — the
  // operator's local WhatsApp doesn't report delivery back to us.
  // When the Meta Cloud API commit lands, its webhook writes this
  // on the `delivered` event. Rule (2026-08-10): the invoice-edit
  // lock keys off THIS column, not invoiceSentAt — an operator who
  // handed off a wa.me draft but hasn't pressed Send in WhatsApp
  // yet can still fix a missed line without a void+reissue dance.
  invoiceDeliveredAt  DateTime?
  // ----- Quality Control -----
  qcChecks            String[] // checkbox values (REPAIR_COMPLETED, ROAD_TEST, ...)
  qcById              String? // QC inspector
  qcBy                User?      @relation("QcJobs", fields: [qcById], references: [id])
  qcAt                DateTime? // sign-off time
  // ----- Delivery (Job-Card-Data-Model.md) -----
  mileageOut          Int?
  deliveredById       String?
  deliveredBy         User?      @relation("DeliveredJobs", fields: [deliveredById], references: [id])
  deliveredAt         DateTime?
  deliveryConfirmedAt DateTime? // customer collection record (WhatsApp confirm = signature equivalent)

  steps           JobStep[]
  estimates       Estimate[]
  invoices        Invoice[]
  partMovements   PartMovement[]
  partRequests    PartRequest[]
  reminders       Reminder[]
  helpers         JobHelper[]
  finding         JobFinding?
  jobParts        JobPart[]
  advancePayments AdvancePayment[]
  workSessions    WorkSession[]
  // Direct-fit receive ledger (AR 2026-08-16). One row per direct-fit
  // arrival on a PO line whose source estimate belongs to this job.
  // See JobPartReceipt + docs/direct-fit-receive-spec.md.
  jobPartReceipts JobPartReceipt[]

  // Per-document customer link token (Phase 1) — used for the delivery
  // confirmation link /c/delivery/<publicToken>. Named publicToken to
  // match Invoice/Estimate/PurchaseOrder even though the current
  // consumer is only delivery — a JobCard only ever gets ONE outbound
  // customer link, so re-using the column for future outbound flows
  // (satisfaction survey, warranty ref) is fine. See Invoice.publicToken
  // for the full Phase 1/2/3 plan.
  publicToken String? @unique

  // ----- Cancellation audit (AR 2026-08-29) -----
  // Every OTHER lifecycle transition on this model has some form of
  // timestamp + actor pair (arrivedAt via createdAt/advisorId,
  // claimedAt/claimedById, workCompletedAt via claimedById, qcAt/qcById,
  // deliveredAt/deliveredById). Cancellation had neither — the only
  // trace was updatedAt changing and status flipping to CANCELLED, so
  // "who cancelled this job, when, and why" was unanswerable.
  //
  // NB: cancellations recorded BEFORE this migration are unattributable
  // — the columns are nullable and back-populated only by future
  // cancel actions. See docs/business-rules.md for the note.
  cancelledAt        DateTime?
  cancelledByUserId  String?
  cancelledBy        User?     @relation("JobCancelledBy", fields: [cancelledByUserId], references: [id])
  cancelReason       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([garageId, number])
  @@index([garageId, status])
}

model JobStep {
  id           String  @id @default(cuid())
  jobCardId    String
  jobCard      JobCard @relation(fields: [jobCardId], references: [id])
  type         String
  photoUrl     String?
  voiceNoteUrl String?
  transcript   String?
  techId       String?
  tech         User?   @relation("TechSteps", fields: [techId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobCardId])
}

// Technician Findings (Job-Card-Data-Model.md) — one per job; submittedAt marks the
// hand-off to the cashier (job advances to ESTIMATE).
model JobFinding {
  id          String    @id @default(cuid())
  jobCardId   String    @unique
  jobCard     JobCard   @relation(fields: [jobCardId], references: [id])
  techId      String?
  tech        User?     @relation("TechFindings", fields: [techId], references: [id])
  findings    String?
  diagnosis   String?
  submittedAt DateTime? // set when submitted to the cashier

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Technician parts list (REQUIRED at diagnosis; USED later). Free-text part No /
// description + optional catalog link. No price — pricing is the cashier's.
model JobPart {
  id          String      @id @default(cuid())
  jobCardId   String
  jobCard     JobCard     @relation(fields: [jobCardId], references: [id])
  kind        JobPartKind @default(REQUIRED)
  partId      String? // optional catalog link
  part        Part?       @relation(fields: [partId], references: [id])
  partNo      String?
  description String
  qty         Int         @default(1)
  createdById String?
  createdBy   User?       @relation("CreatedJobParts", fields: [createdById], references: [id])

  // "Price this part" back-link (AR 2026-08-19). Non-null when the
  // advisor has priced this tech-required part into an EstimateLine.
  // The PartRow uses this to hide the "Price this part" button (no
  // duplicate-line clicks) and instead show the priced amount.
  //
  // onDelete: SetNull — when the advisor deletes the EstimateLine
  // the JobPart becomes priceable again (per AR 2026-08-19: "if the
  // advisor later deletes that estimate line, the JobPart should
  // become priceable again"). We DO NOT want the JobPart to vanish
  // when its line is deleted — it's still a real thing the tech
  // requested. Nor do we want an orphaned FK — clearing it is the
  // exact correct semantic.
  //
  // @unique because Prisma requires it for a 1:1 optional relation
  // (and the semantic matches: no EstimateLine should ever be the
  // priced-from target of more than one JobPart — each priced tech
  // request has exactly one line). A future "re-link this JobPart to
  // a different line" flow just moves the FK; the uniqueness holds.
  createdAt      DateTime      @default(now())
  estimateLineId String?       @unique
  estimateLine   EstimateLine? @relation("EstimateLinePricedFromJobPart", fields: [estimateLineId], references: [id], onDelete: SetNull)

  @@index([jobCardId, kind])
}

/// Direct-fit receipt ledger (AR 2026-08-16). Records the physical
/// arrival of a part that was bought for a specific job and never
/// enters stock — the "ball joint for a specific Ford F150" case
/// (see docs/direct-fit-receive-spec.md for the two-category model).
///
/// Written by receivePurchaseOrderAction when the operator picks the
/// "Direct-fit" branch on an unlinked PO line. Never by any other
/// path. Discovering this row against a job means: this part arrived,
/// the invoiced cost is authoritative (receivedUnitCost), and no
/// catalogue Part row exists for it.
///
/// The stock path (PartMovement + Part.qtyOnHand blend) does NOT
/// write here; the two paths are mutually exclusive per PO-line
/// receive event.
model JobPartReceipt {
  id                  String            @id @default(cuid())
  // The job this part physically landed on. Resolved from the PO
  // line's sourceEstimateLine.jobCardId at write time; if that
  // chain isn't present the receive action refuses the direct-fit
  // path (there's no stock alternative for a partId=null line
  // without a job link).
  jobCardId           String
  jobCard             JobCard           @relation(fields: [jobCardId], references: [id])
  // The PO line this receipt closes. Cascades on PO delete
  // because the PO document IS the source of truth for what was
  // ordered — losing the PO means losing every downstream
  // receipt-against-PO record along with it.
  purchaseOrderLineId String
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)
  // Description snapshot at receive time — the PO line's own
  // description (or Part.name if it was somehow linked). Frozen
  // here so a later PO-line edit doesn't rewrite receipt history.
  description         String
  qty                 Int
  // The supplier's ACTUAL per-unit price at delivery — the number
  // the shop should use when reporting profit on this job. May
  // differ from the estimate line's unitCost (which is what the
  // advisor expected); the receive action reconciles by updating
  // the estimate line's unitCost when the estimate hasn't yet
  // been invoiced (post-invoice snapshots stay frozen — see the
  // ordering rule in the spec).
  receivedUnitCost    Decimal           @db.Decimal(12, 2)
  // Supplier / manufacturer part number captured at receive time.
  // Optional — many shops don't type the SKU on a walk-in-and-fit
  // part. Used only for record-keeping / warranty lookups.
  receivedPartNo      String?
  createdAt           DateTime          @default(now())

  @@index([jobCardId])
  @@index([purchaseOrderLineId])
}

// ---------- Estimate / Invoice / Payment ----------
model Estimate {
  id             String         @id @default(cuid())
  jobCardId      String
  jobCard        JobCard        @relation(fields: [jobCardId], references: [id])
  subtotal       Decimal        @db.Decimal(12, 2)
  vatAmount      Decimal        @db.Decimal(12, 2)
  total          Decimal        @db.Decimal(12, 2)
  status         EstimateStatus @default(DRAFT)
  // set when the operator taps 'Send via WhatsApp' — HANDED OFF to the
  // operator's WhatsApp, NOT confirmed delivery. Mirrors
  // JobCard.invoiceSentAt (AR 2026-08-15 estimate-honesty pass). Also
  // marks the end of the pricing-duration window.
  sentAt         DateTime?
  // Set only when we KNOW the estimate reached the customer. In the
  // wa.me era this stays null forever — the operator's local WhatsApp
  // doesn't report delivery back to us. When the Meta Cloud API
  // webhook lands, its `delivered` event writes this. Column added
  // now (AR 2026-08-15) so estimates + invoices stay symmetrical.
  // Mirror of JobCard.invoiceDeliveredAt.
  deliveredAt    DateTime?
  approvedAt     DateTime? // audit: when the customer approved (dispute shield)
  approvedAmount Decimal?       @db.Decimal(12, 2)

  // Per-document customer link token (Phase 1) — see Invoice.publicToken
  // for the full doc. Dormant during Phase 1; Phase 2 flips /c/estimate
  // to use this column instead of the HMAC of estimate.id.
  publicToken String? @unique

  // AR 2026-08-25 Batch C — three additive optional fields matching
  // the real UAE-shop estimate format.
  //
  // paymentTerms: per-estimate override for the Payment Terms block.
  //   Renderer reads paymentTerms ?? garage.defaultPaymentTerms ??
  //   null; both null = block omitted. Advisor sets when the doc
  //   deviates (fleet net-30, cash on collection).
  paymentTerms         String?
  // remarks: free-text scope-limitation shown above the totals.
  //   Real example: "This estimate is prepared only for the required
  //   work to make the engine start and run. Further diagnosis will
  //   be required..." Per-estimate BY NATURE — a garage default
  //   would go stale and get ignored, which is worse than blank.
  remarks              String?
  // advisorNameSnapshot + advisorPhoneSnapshot: captured at Send
  //   time (sendEstimateToCustomerAction) so the printed document
  //   still names the right person after a staff change. Same
  //   discipline as InvoiceLine.unitCost — a customer's copy of
  //   the document should say what it said when they got it.
  //   Renderer prefers the snapshot; falls back to the live
  //   advisor row when snapshot is null (drafts, un-sent estimates).
  advisorNameSnapshot  String?
  advisorPhoneSnapshot String?

  lines   EstimateLine[]
  invoice Invoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobCardId])
}

model EstimateLine {
  id          String   @id @default(cuid())
  estimateId  String
  estimate    Estimate @relation(fields: [estimateId], references: [id])
  kind        LineKind
  partId      String?
  part        Part?    @relation(fields: [partId], references: [id])
  description String
  qty         Decimal  @db.Decimal(10, 2)
  // Cost-based pricing (AR 2026-08-12). unitCost = supplier per-unit
  // price the shop pays (from a PO / catalogue Part.cost / manual
  // entry). markupPct = the % the advisor set at price time. Both
  // nullable — labor + fee lines don't have a "cost" concept, and
  // legacy rows from before this feature have neither. unitPrice
  // stays the authoritative selling price. Relationship:
  //   unitPrice = round(unitCost × (1 + markupPct/100), 2)
  // In the line editor the three inputs (cost / markup / price) are
  // two-way bound: change cost or markup → price recomputes; type a
  // new price → markup recomputes. Persistence saves whatever the
  // advisor last committed on the row, which keeps the derived
  // relationship implicit + auditable. Cost + markup are INTERNAL —
  // customer-facing surfaces render only unitPrice + lineTotal.
  unitCost    Decimal? @db.Decimal(12, 2)
  markupPct   Decimal? @db.Decimal(5, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)
  vatRate     Decimal  @default(0.05) @db.Decimal(5, 4)
  declined    Boolean  @default(false) // customer chose to skip this item

  // Estimate → PO auto-create back-relation (2026-07-24). Non-null on
  // the Part row when this line spawned it via the from-estimate flow.
  // See Part.autoCreatedFromLineId for the design.
  autoCreatedPart Part? @relation("PartAutoCreatedFromLine")

  // "Price this part" back-link (AR 2026-08-19). At most one JobPart
  // maps to this line (JobPart.estimateLineId is @unique). Non-null
  // when the line was created via addLineFromPartAction on a tech-
  // required JobPart; null for lines added via the manual Add-line
  // form. Set on delete: JobPart.estimateLineId clears (onDelete:
  // SetNull on that side), so this line's deletion makes the tech
  // request priceable again.
  pricedFromJobPart JobPart? @relation("EstimateLinePricedFromJobPart")

  // Direct-fit receive (AR 2026-08-16). Every PO line born from the
  // from-estimate flow carries a back-link to its source estimate line
  // so the direct-fit receive path can (a) know which JobCard the
  // part arrived for (via estimate → jobCard), and (b) update this
  // line's unitCost if the actual supplier price differs, provided
  // no invoice has been generated yet (post-invoice snapshots are
  // frozen — see docs/direct-fit-receive-spec.md).
  poLinesSourced PurchaseOrderLine[] @relation("PoLineSourceEstimate")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estimateId])
}

model Invoice {
  id              String          @id @default(cuid())
  garageId        String
  garage          Garage          @relation(fields: [garageId], references: [id])
  jobCardId       String
  jobCard         JobCard         @relation(fields: [jobCardId], references: [id])
  estimateId      String?         @unique
  estimate        Estimate?       @relation(fields: [estimateId], references: [id])
  number          Int // per-garage gapless sequence
  customerTrn     String?
  issuedAt        DateTime        @default(now())
  dueDate         DateTime
  subtotal        Decimal         @db.Decimal(12, 2)
  vatAmount       Decimal         @db.Decimal(12, 2)
  total           Decimal         @db.Decimal(12, 2)
  qrPayload       String? // KSA hook — exists day one
  // AR 2026-09-03 (E4b) — emirate snapshot at generation time. See
  // rule 14 for the discipline: read Garage.emirate ONCE inside the
  // generation tx and freeze the value onto this row. A garage that
  // later changes its emirate (moves office, adds a branch) doesn't
  // rewrite the emirate on invoices that were already issued —
  // Form 201 for a prior quarter must never change.
  //
  // Void reversal (INVOICE_VOID ledger rows) has NO separate emirate
  // — the VAT summary joins the reversal back to this Invoice row
  // via sourceId, so the reversal always lands in the same emirate
  // box as the original. Same discipline as InvoiceLine.unitCost.
  //
  // Nullable during rollout: pre-cutover invoices are back-filled
  // from Garage.emirate (which may itself be null for a garage the
  // operator hasn't set yet). Coverage banner surfaces null-emirate
  // invoices on the VAT summary so the shop can either backfill
  // the garage's setting + re-void or accept an "unassigned" box.
  emirate         Emirate?
  status          InvoiceStatus   @default(DRAFT)
  clearanceStatus ClearanceStatus @default(NA) // KSA hook

  // AR 2026-08-25 parity with Estimate — same four blocks the
  // customer already sees on the estimate now also on the invoice.
  //
  //   remarks               — per-invoice scope-limitation text.
  //                           Copied from source estimate at
  //                           generation; cashier can edit on the
  //                           invoice editor.
  //   paymentTerms          — per-invoice override for the shop's
  //                           default terms. Renderer reads
  //                             invoice.paymentTerms
  //                               ?? garage.defaultPaymentTerms
  //                               ?? null
  //                           Copied from source estimate at
  //                           generation; cashier can edit at
  //                           billing time (deposit was taken, or
  //                           the customer agreed something
  //                           different).
  //   advisorNameSnapshot   — advisor identity at invoice generation
  //   advisorPhoneSnapshot   time. Copied from the estimate's
  //                           snapshot; falls back to the JobCard's
  //                           current advisor if the estimate wasn't
  //                           sent (advisor snapshot null). Never
  //                           re-written after generation — the
  //                           document says who quoted the work at
  //                           the moment the bill was cut, matching
  //                           the estimate's "advisor at first
  //                           customer contact wins" discipline.
  remarks              String?
  paymentTerms         String?
  advisorNameSnapshot  String?
  advisorPhoneSnapshot String?

  // Void + reissue (2026-08-10). A delivered invoice can't be edited
  // — corrections happen by voiding the original and issuing a fresh
  // one that takes the next sequential number. Both documents point
  // at each other so an auditor can walk the trail in either
  // direction. `previousInvoiceId` on the corrected row → the void.
  // The self-relation's back-reference exposes it as
  // `replacedBy` on the voided row (one row can only be replaced
  // once, hence @unique). Sequence stays gapless: the VOID row
  // keeps its number, the correction takes the next number.
  previousInvoiceId String?   @unique
  previousInvoice   Invoice?  @relation("InvoiceCorrection", fields: [previousInvoiceId], references: [id])
  replacedBy        Invoice?  @relation("InvoiceCorrection")
  voidedAt          DateTime?
  voidedByUserId    String?
  voidedBy          User?     @relation("InvoiceVoidedBy", fields: [voidedByUserId], references: [id])

  // Per-document customer link token (Phase 1, 2026-08-10). Random
  // opaque string stored server-side, used as the URL segment for
  // /c/invoice/<publicToken> once Phase 2 flips the signers. HMAC-based
  // signing (see @/lib/tokens) remains the active path for now — this
  // column is dormant, populated only by backfill so it's ready when
  // Phase 2 lands. Nullable during rollout; Phase 2's write path fills
  // it at create time; Phase 3 removes HMAC entirely.
  publicToken String? @unique

  lines    InvoiceLine[]
  payments Payment[]
  sends    InvoiceSend[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([garageId, number]) // VAT: gapless, per-garage numbering
  @@index([garageId, status])
}

// SNAPSHOT — invoice is a legal doc; never re-reads the estimate.
model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  kind        LineKind
  description String
  qty         Decimal  @db.Decimal(10, 2)
  // Cost snapshot at invoice-generation time (AR 2026-08-12). Copied
  // from the source EstimateLine so realized-margin reports work off
  // the immutable invoice, not the still-editable estimate. Nullable
  // for lines with no cost concept (labor / fee) + legacy rows.
  // Never rendered to the customer — see /c/invoice for the select:
  // allowlist that keeps this out of the RSC payload.
  unitCost    Decimal? @db.Decimal(12, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)
  vatRate     Decimal  @default(0.05) @db.Decimal(5, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  amount    Decimal  @db.Decimal(12, 2)
  method    String
  paidAt    DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  // Cashier Payments tab sorts by MAX(paidAt) DESC across the shop.
  @@index([paidAt])
}

// Advance payments — slice 6b. Stored on the JOB so the customer can pay
// before the invoice exists (after estimate approval but before TECH_COMPLETE).
// At invoice-generation time, generateInvoiceAction migrates each unmigrated
// row into a Payment attached to the new Invoice and stamps migratedAt /
// paymentId for audit. paymentId is not a Prisma relation — just a recorded
// id — to keep this model self-contained and avoid coupling Payment to a
// schema concept that only exists for advances.
//
// Accounting (zero-entry, see billing.ts):
//  - At advance time:   DR Cash / CR Customer Deposits   (advanceLedger)
//  - At migration time: DR Customer Deposits / CR AR     (advanceMigrationLedger)
// Cash is recognized ONCE (at advance time); migration is a balance-sheet
// reclassification, not a second cash event.
model AdvancePayment {
  id         String   @id @default(cuid())
  garageId   String
  garage     Garage   @relation(fields: [garageId], references: [id])
  jobCardId  String
  jobCard    JobCard  @relation(fields: [jobCardId], references: [id])
  amount     Decimal  @db.Decimal(12, 2)
  method     String // "CASH" | "CARD_POS"
  receivedAt DateTime @default(now())

  migratedAt DateTime? // null = still on job, set = transferred to an Invoice
  paymentId  String? // id of the Payment row created at migration (audit)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobCardId])
  @@index([garageId])
  // Owner ledger UNION with Payment sorts by receivedAt DESC across all
  // shop advances. Mirror of Payment @@index([paidAt]).
  @@index([receivedAt])
}

// ---------- Inventory ----------
model Part {
  id        String  @id @default(cuid())
  garageId  String
  garage    Garage  @relation(fields: [garageId], references: [id])
  sku       String
  name      String
  qtyOnHand Int     @default(0)
  cost      Decimal @db.Decimal(12, 2)
  price     Decimal @db.Decimal(12, 2)

  // Inventory Phase 1 (2026-07-04). Both additive:
  //   reorderLevel — per-part low-stock threshold; replaces the hardcoded
  //     "5" in owner-metrics inventoryHealth(). Default 5 preserves the
  //     old behaviour for existing rows.
  //   active — soft-delete for discontinued parts. Kept out of pickers /
  //     catalog when false; never hard-deleted so historical JobPart /
  //     EstimateLine references stay intact.
  reorderLevel Int     @default(5)
  active       Boolean @default(true)

  // Inventory 1c (2026-07-04). OPTIONAL supplier link — a catalog part
  // may record which supplier it "comes from". Nullable and additive: it
  // does NOT change how parts are created/used in the existing job /
  // estimate flow; a part with no supplier behaves exactly as before.
  // Supplier is soft-deleted (active flag), never hard-deleted, so this
  // reference is never left dangling.
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  // Estimate → PO auto-create (2026-07-24). Optional back-reference to
  // the free-text EstimateLine this Part was auto-created from. When
  // set, the inventory table shows an "auto" badge so the owner can
  // spot Parts that were spawned by the from-estimate flow and may
  // still have `cost = 0` waiting for a supplier price. Nullable +
  // @unique: at most one Part per source line (re-running the flow on
  // the same line links to the existing Part instead of duplicating).
  // Kept nullable rather than a required boolean so the audit is
  // lossless — "which line spawned this?" is answerable in one query.
  autoCreatedFromLineId String?       @unique
  autoCreatedFromLine   EstimateLine? @relation("PartAutoCreatedFromLine", fields: [autoCreatedFromLineId], references: [id])

  movements          PartMovement[]
  estimateLines      EstimateLine[]
  partRequests       PartRequest[]
  jobParts           JobPart[]
  purchaseOrderLines PurchaseOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([garageId, sku])
  @@index([supplierId])
  // Owner inventory table sorts by (garageId, name) — pagination is
  // server-side once shops grow past ~2k parts.
  @@index([garageId, name])
}

// Inventory 1c (2026-07-04) — supplier directory. OWNER-only, garage-scoped.
// Purely a reference list the owner maintains (who they buy parts from);
// Phase 2 Purchasing will reference these when raising purchase orders.
// Deactivated (active=false) rather than hard-deleted so historical part
// references and future PO history stay intact.
model Supplier {
  id            String  @id @default(cuid())
  garageId      String
  garage        Garage  @relation(fields: [garageId], references: [id])
  name          String
  contactPerson String?
  phone         String?
  email         String?
  trn           String? // supplier tax registration number (UAE TRN)
  address       String?
  active        Boolean @default(true)

  parts          Part[]
  purchaseOrders PurchaseOrder[]
  bills          SupplierBill[]
  payments       SupplierPayment[]
  expenses       Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([garageId])
}

// Inventory Phase 2 (2026-07-04) — a stock-replenishment order to a supplier.
// Owner-only, garage-scoped. Lines snapshot the ordered qty + unit cost; on
// RECEIVED (2b) each line increments the part's stock via a PartMovement.
model PurchaseOrder {
  id         String              @id @default(cuid())
  garageId   String
  garage     Garage              @relation(fields: [garageId], references: [id])
  supplierId String
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  status     PurchaseOrderStatus @default(DRAFT)
  // Author's INTENT at document creation. Distinguishes "I asked a
  // supplier to quote" (QUOTE) from "I'm placing an order at prices I
  // already know" (ORDER). Set once at creation from the form's
  // mode= field; never changes afterwards. `poDocKind` uses it to
  // decide the title while status is DRAFT — a DRAFT+ORDER doc reads
  // as "Purchase Order (draft)" instead of "Request for Quotation".
  // Post-DRAFT statuses are governed by status alone (see
  // src/lib/po-doc-kind.ts). From-estimate flows default to QUOTE
  // since the estimate might not have final prices yet.
  intent     PurchaseOrderIntent @default(QUOTE)
  reference  String? // supplier quote / PO reference
  note       String?
  orderedAt  DateTime? // when marked ORDERED (sent to supplier)
  receivedAt DateTime? // when stock was received (2b)

  // Document-level default vehicle (2026-08-02). Snapshot columns —
  // same shape as PurchaseOrderLine.vehicle*. Set on new-quotation /
  // new-purchase-order create. Purpose: pre-fill the Add-line form on
  // the detail page so the owner doesn't have to repick the car for
  // every line, and to render a header caption when every line
  // resolves to the same vehicle. Per-line snapshots on
  // PurchaseOrderLine remain the sole source of truth for what the
  // supplier saw; the defaults here are copied into each new line at
  // write time, never referenced live at render.
  //
  // All nullable. An owner can skip vehicle entry entirely at
  // creation time and set it per-line on Add. Fields not carried on
  // the from-estimate path (the job's vehicle populates line
  // snapshots directly).
  //
  // `defaultVehicleId` is an OPTIONAL soft link to a Vehicle row when
  // the owner picked a car already in the garage. Kept for the
  // "which car in your garage?" cross-reference on later reports; a
  // Vehicle edit does NOT retroactively change the sent supplier
  // document (that's what the frozen make/model/year/plate/vin/etc.
  // columns are for). No @relation — snapshot lifecycle only.
  defaultVehicleId         String?
  defaultVehicleMake       String?
  defaultVehicleModel      String?
  defaultVehicleYear       Int?
  defaultVehiclePlate      String?
  defaultVehicleVin        String?
  defaultVehicleEngineSize String?
  defaultVehicleFuelType   String?
  // Job card number (per-garage sequential) captured at doc-default
  // time when the operator identified the car by JC# instead of by
  // plate. Snapshot only — a later JobCard rename or renumber does
  // NOT retroactively rewrite the supplier document. Copied into each
  // new line's own `vehicleJobNumber` at Add-line time via the same
  // default-fallback path as the other vehicle fields.
  defaultVehicleJobNumber  Int?

  // Per-document supplier link token (Phase 1) — see Invoice.publicToken
  // for the full doc. Used for /c/po/<publicToken> once Phase 2 flips
  // the sender action; dormant during Phase 1.
  publicToken String? @unique

  lines     PurchaseOrderLine[]
  sends     PurchaseOrderSend[]
  movements PartMovement[]
  bills     SupplierBill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([garageId, status])
  @@index([supplierId])
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  // Catalog link — NULLABLE from 2026-08-01. A quotation / PO line
  // may exist as description-only when the Part hasn't yet been
  // created — the catalogue row is born at goods receipt with the
  // real SKU and cost (Layer 5). Existing rows are all non-null;
  // the widen rewrites nothing. Row-level CHECK enforces "at least
  // one of partId or description".
  partId          String?
  part            Part?         @relation(fields: [partId], references: [id])
  // Free-text description of what's being ordered. Written ONCE at
  // line create — from the estimate line's description on the
  // from-estimate path, or from the owner's typed input on a manual
  // add. Kept even after Layer 5 attaches partId at goods receipt:
  // the "originally asked for" text survives so the linked
  // Part.name doesn't erase the record of what the supplier was
  // actually invoiced for. Render rule everywhere:
  //   part?.name ?? description ?? "—"
  description     String?
  // Supplier SKU. Captured when a supplier quotes their own code,
  // or when the owner types the real SKU at receive time. Used by
  // receivePurchaseOrderAction (Layer 5) to link an existing Part
  // or seed a fresh one.
  sku             String?
  qty             Int // ordered quantity
  receivedQty     Int           @default(0) // how much has been received so far (2b partial receiving; 0 ≤ receivedQty ≤ qty)
  returnedQty     Int           @default(0) // how much has been returned to the supplier (2c; 0 ≤ returnedQty ≤ receivedQty)
  // NULL = awaiting a supplier quote; 0 = quoted as no-charge (a
  // warranty replacement, a courtesy line). The two facts are
  // different — canMarkOrdered admits 0 but rejects null. See
  // src/lib/po-doc-kind.ts.
  unitCost        Decimal?      @db.Decimal(12, 2)

  // Vehicle assignment — snapshot at line-write time. A PO is a document
  // sent to a supplier; a later Vehicle edit must NOT retroactively change
  // what the supplier already received.
  //
  // Three shapes:
  //   1. vehicleId set + snapshot fields populated → linked to a Vehicle
  //      row, snapshot frozen at write.
  //   2. vehicleId null + snapshot fields populated → walk-in / stock
  //      order; car not in the system, advisor typed the details.
  //   3. all fields null → no vehicle linked (pre-existing catalog buy
  //      with no context).
  //
  // Display readers use snapshot fields directly; vehicleId is for
  // history/reporting only. See src/lib/po-vehicle.ts.
  //
  // ── LIFECYCLE (READ THIS BEFORE ADDING A "SYNC VEHICLE DATA" HELPER) ──
  // • Snapshot fields are WRITTEN ONCE at line creation (auto-resolved
  //   from Part.autoCreatedFromLine chain OR from the picker/free-text
  //   form) and are EDITABLE ONLY BY THE ADVISOR through the PO line's
  //   own edit form.
  // • They are NEVER refreshed from the linked Vehicle after creation —
  //   not by a cron, not by a "keep-in-sync" helper, not by a Vehicle
  //   update trigger. A document that changes retroactively after being
  //   sent to a supplier is a bug and a legal problem.
  // • The backfill in migration 20260727120000 populates only rows where
  //   ALL identity snapshot columns are NULL. Do NOT relax that guard.
  //
  // Identifiers (VIN, plate, part number) stay in Latin script under any
  // locale. Do NOT wrap these strings in translation helpers.
  vehicleId         String?
  vehicle           Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleMake       String?
  vehicleModel      String?
  vehicleYear       Int?
  vehicleEngineSize String?
  vehicleFuelType   String?
  vehicleVin        String?
  vehiclePlate      String?
  vehicleJobNumber  Int?

  // Direct-fit receive (AR 2026-08-16). Populated on the from-estimate
  // path so the receive action can (a) associate a direct-fit receipt
  // with the right JobCard via estimate → jobCard, and (b) update
  // this estimate line's cost with the actual supplier price when it
  // differs (only if the estimate hasn't yet been invoiced).
  // Nullable so manually-added POLines (no estimate origin) still
  // work — those can only take the stock path today. See
  // docs/direct-fit-receive-spec.md.
  sourceEstimateLineId String?
  sourceEstimateLine   EstimateLine? @relation("PoLineSourceEstimate", fields: [sourceEstimateLineId], references: [id])

  // Direct-fit receipt ledger — one row per direct-fit receive event
  // on this line. Empty for stock-path lines. See JobPartReceipt.
  jobPartReceipts JobPartReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseOrderId])
  @@index([vehicleId])
  @@index([sourceEstimateLineId])
}

// PO send audit log — one row per send attempt (WhatsApp intent or Email).
// Answers "did we already ask this supplier, and for what?" — visible on
// the PO detail page under "Sent history" (newest first, empty state when
// nothing has gone out).
//
// Snapshot vs. join:
//   • recipient is a STRING SNAPSHOT of the address/number actually used,
//     NOT a live join to Supplier. If the supplier's email or phone
//     changes later, history must still show where the message actually
//     went — the audit is worthless if it retroactively lies.
//   • documentKind is a SNAPSHOT of what the PO was when it left the
//     shop. A PO/RFQ can be edited after sending (advisor adds a price,
//     unpriced lines fill in) — the row still says "this went out as an
//     RFQ" because that is what the supplier received.
//
// Channel semantics:
//   • WHATSAPP — server logs HANDED_OFF when the button click reaches
//     the redirect action; there is no callback, so the row terminates
//     there. UI copy must be honest: "Opened in WhatsApp — delivery not
//     confirmed." A row implying a message was sent when the user closed
//     WhatsApp is worse than no row at all.
//   • EMAIL — HANDED_OFF written before the Resend call for symmetry;
//     transitions to SENT (Resend accepted) or FAILED (errorCode set).
//     DELIVERED is intentionally NOT in the enum: it needs a Resend
//     delivery webhook which ships with the webhook commit, not before.
//
// providerMessageId is Resend's message id (email only) — used by the
// future webhook to look up the row and mark DELIVERED. Never rendered
// to the browser (leaks account details / correlation).
//
// errorCode is our OWN enum only ("no_recipient", "unverified_domain",
// "not_configured", "provider_error") — the four codes the render-side
// whitelist accepts. NEVER stores the provider's own error message —
// those go to server-side logs. See src/lib/mail.ts.
model PurchaseOrderSend {
  id                String                    @id @default(cuid())
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder             @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  garageId          String
  garage            Garage                    @relation(fields: [garageId], references: [id])
  channel           PurchaseOrderSendChannel
  recipient         String // snapshot at send time — email address or phone, per channel
  documentKind      PurchaseOrderDocumentKind // snapshot of PO vs RFQ classification at send time
  sentByUserId      String
  sentBy            User                      @relation("PurchaseOrderSentBy", fields: [sentByUserId], references: [id])
  // Sender's display name AT SEND TIME. Same snapshot argument as
  // `recipient` and `documentKind`: a staff member leaving or being
  // renamed must not retroactively rewrite who sent a document. The
  // history table prefers this string; falls back to the User join
  // only when null (defensive against any pre-migration row — none
  // can exist today since this ships in the same commit as the
  // first writer, but keeping the fallback costs nothing and keeps
  // the reader honest about the ordering).
  sentByName        String?
  status            PurchaseOrderSendStatus
  providerMessageId String? // email only (Resend id); null for WHATSAPP
  errorCode         String? // our enum only, never provider text (see src/lib/mail.ts MailErrorCode)

  createdAt DateTime @default(now())

  @@index([purchaseOrderId])
  @@index([garageId])
}

// Send audit log for customer invoices — parallels PurchaseOrderSend
// exactly. Motivation: `JobCard.invoiceSentAt` on its own says "we
// stamped it," but when a customer says "I never got the invoice" a
// month later the cashier needs to see WHICH number the message was
// handed off to, WHO handed it off, and WHEN. A boolean-with-timestamp
// on the parent row can't answer any of those.
//
// The row is written BEFORE the wa.me redirect fires (mirrors PO). If
// the wa.me redirect never fires (server crash, etc.), the row exists
// and the read side sees "handed_off" without a corresponding paper
// trail on WhatsApp — that's the correct signal to the operator that
// something went sideways at send time, not a claim we made up.
model InvoiceSend {
  id                String             @id @default(cuid())
  invoiceId         String
  invoice           Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  garageId          String
  garage            Garage             @relation(fields: [garageId], references: [id])
  channel           InvoiceSendChannel
  recipient         String // snapshot at send time — email address or phone, per channel
  sentByUserId      String
  sentBy            User               @relation("InvoiceSentBy", fields: [sentByUserId], references: [id])
  // Sender's display name AT SEND TIME. Same snapshot rule as
  // PurchaseOrderSend.sentByName.
  sentByName        String?
  status            InvoiceSendStatus
  providerMessageId String? // reserved for the Meta Cloud API commit; null on wa.me hand-off
  errorCode         String? // our own enum only, never provider text

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([garageId])
}

// Inventory OCR import (2026-07-05). A photographed supplier invoice, OCR'd
// into draft lines. OWNER-only, garage-scoped. imageUrl keeps the source
// photo for the audit trail. Lines are a REVIEW BUFFER — nothing becomes a
// catalog Part until the owner confirms. `flagged` = OCR was not confident
// (blank/uncertain value) so the UI highlights it; `include` = the owner's
// keep/skip checkbox.
model PartsImport {
  id           String            @id @default(cuid())
  garageId     String
  garage       Garage            @relation(fields: [garageId], references: [id])
  imageUrl     String // stored invoice photo (audit trail)
  supplierName String? // OCR'd header supplier name (informational)
  status       PartsImportStatus @default(DRAFT)
  createdById  String?
  createdBy    User?             @relation("PartsImportedBy", fields: [createdById], references: [id])

  lines PartsImportLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([garageId, status])
}

model PartsImportLine {
  id            String      @id @default(cuid())
  partsImportId String
  partsImport   PartsImport @relation(fields: [partsImportId], references: [id], onDelete: Cascade)
  name          String // may be blank if OCR was unsure
  sku           String?
  qty           Int         @default(1)
  unitCost      Decimal     @default(0) @db.Decimal(12, 2)
  flagged       Boolean     @default(false) // low-confidence — UI highlights it
  include       Boolean     @default(true) // owner's keep/skip checkbox

  createdAt DateTime @default(now())

  @@index([partsImportId])
}

// Stock movement audit — one row per delta on Part.qtyOnHand.
// Historical rows encoded the purchase-order link only in the free-
// text `reason` ("Received PO ORD-42 — Al Futtaim"), which was
// neither indexable nor reliable (supplier reference is optional and
// the string could drift). 2026-08-09 added:
//   - garageId (FK, backfilled from part.customer.garageId) — closes
//     the transitive-only isolation that made cross-garage queries
//     require a Part join.
//   - purchaseOrderId (nullable FK) — the direct link, queryable
//     both ways: "movements from this PO" and "which PO did this
//     movement come from".
//   - kind (enum) — replaces `reason` as the join key for reporting.
//     `reason` stays as a human note.
model PartMovement {
  id              String           @id @default(cuid())
  partId          String
  part            Part             @relation(fields: [partId], references: [id])
  garageId        String
  garage          Garage           @relation(fields: [garageId], references: [id])
  jobCardId       String?
  jobCard         JobCard?         @relation(fields: [jobCardId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])
  kind            PartMovementKind @default(MANUAL_ADJUSTMENT)
  delta           Int
  // Snapshot of per-unit cost at the time this movement was written.
  // AR 2026-09-03 (E6) — required for the /owner/accounting/purchases
  // by-part spend breakdown. Only meaningful when kind='PO_RECEIPT'
  // or 'PO_RETURN'; MANUAL_ADJUSTMENT + GOODS_ISSUE writers leave it
  // null. Historical rows (pre-E6) are null and read as "unknown cost"
  // on the purchase summary — coverage note names the count.
  // Nullable, no backfill script (2 historical rows on Prod at
  // cutover; same discipline as rule 14 emirate cutover).
  unitCost        Decimal?         @db.Decimal(12, 2)
  reason          String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partId])
  @@index([garageId])
  @@index([purchaseOrderId])
}

// Movement source. MANUAL_ADJUSTMENT is the default so a pre-migration
// row (which we can't reclassify — the reason text was truncated /
// fuzzy) reads as "adjusted by hand" rather than falsely claiming to
// be a PO receipt. New rows always set the correct kind explicitly.
//   PO_RECEIPT        — positive delta from receivePurchaseOrderAction
//   PO_RETURN         — negative delta from the return-to-supplier path
//   MANUAL_ADJUSTMENT — /owner/inventory adjustStockAction (± delta)
//   GOODS_ISSUE       — reserved for future job-consumption writes
//                       (JobPart move-to-USED). Not yet emitted.
enum PartMovementKind {
  PO_RECEIPT
  PO_RETURN
  MANUAL_ADJUSTMENT
  GOODS_ISSUE
}

// Tier 1 #3 — the part-request loop. A technician asks for a part; the advisor /
// parts person fulfills (in stock) or orders (out of stock → job auto-pauses).
model PartRequest {
  id            String            @id @default(cuid())
  garageId      String
  garage        Garage            @relation(fields: [garageId], references: [id])
  jobCardId     String
  jobCard       JobCard           @relation(fields: [jobCardId], references: [id])
  partId        String? // catalog part, if known
  part          Part?             @relation(fields: [partId], references: [id])
  description   String // free-text (used when no catalog part)
  qty           Int               @default(1)
  status        PartRequestStatus @default(REQUESTED)
  requestedById String? // the technician who asked
  requestedBy   User?             @relation("PartRequestedBy", fields: [requestedById], references: [id])
  note          String? // advisor note (e.g. supplier, ETA)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([garageId, status])
  @@index([jobCardId])
}

// Tier 2 #4 — additional technicians (helpers) on one car, alongside the primary
// claimer. Helpers may log work; the claimer keeps the claim/release.
// Tech-tracking slice 1 — one row per continuous stretch of a technician
// working ONE car. endedAt null = the tech is on this car right now; a
// tech can have at most ONE open row, enforced by a hand-written partial
// unique index in the migration:
//   CREATE UNIQUE INDEX "WorkSession_one_open_per_tech"
//     ON "WorkSession"("techId") WHERE "endedAt" IS NULL;
// Prisma can't express partial indexes — do NOT let a future generated
// migration drop it (we hand-write migrations anyway).
model WorkSession {
  id        String    @id @default(cuid())
  garageId  String
  jobCardId String
  jobCard   JobCard   @relation(fields: [jobCardId], references: [id])
  techId    String
  tech      User      @relation("TechWorkSessions", fields: [techId], references: [id])
  startedAt DateTime  @default(now())
  endedAt   DateTime? // null = live segment
  endReason String? // SWITCHED | SENT_FOR_ESTIMATE | COMPLETED | JOB_CLOSED | AUTO_CLOSED (2026-08-20, nightly cron)

  // AR 2026-08-12 profit reporting Step 4 — labour cost frozen at
  // session close. Value = hours(session) × Garage.defaultLaborHourlyCost
  // at the moment endedAt is written. Later rate changes never touch
  // a closed session, so historical profit reports stay stable. Null
  // means unknown (no rate set at close time, or a pre-Step-4 row);
  // the profit card counts these into its Unknown bucket, never as
  // "zero cost / 100% margin".
  laborCostSnapshot Decimal? @db.Decimal(12, 2)

  @@index([jobCardId])
  @@index([techId, endedAt])
  @@index([garageId, endedAt])
}

model JobHelper {
  id        String  @id @default(cuid())
  jobCardId String
  jobCard   JobCard @relation(fields: [jobCardId], references: [id])
  techId    String
  tech      User    @relation("TechHelp", fields: [techId], references: [id])

  createdAt DateTime @default(now())

  @@unique([jobCardId, techId])
  @@index([techId])
}

// Tier 2 #7 — bays/ramps as a limited physical resource. A car may occupy one bay.
model Bay {
  id       String @id @default(cuid())
  garageId String
  garage   Garage @relation(fields: [garageId], references: [id])
  name     String

  jobCards JobCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([garageId, name])
}

// Workflow-Spec step 16 — automated maintenance reminders. Scheduled when a job
// completes; auto-sent (routine) when due. dueAt = serviceDate + per-type interval.
model Reminder {
  id          String         @id @default(cuid())
  garageId    String
  garage      Garage         @relation(fields: [garageId], references: [id])
  vehicleId   String
  vehicle     Vehicle        @relation(fields: [vehicleId], references: [id])
  jobCardId   String? // the service that triggered it
  jobCard     JobCard?       @relation(fields: [jobCardId], references: [id])
  type        ReminderType
  serviceDate DateTime // when the service was performed
  dueAt       DateTime // when to remind (serviceDate + interval)
  status      ReminderStatus @default(SCHEDULED)
  sentAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([garageId, status, dueAt])
  @@index([vehicleId])
}

// ---------- Zero-entry accounting (rows generated by services only) ----------
model LedgerEntry {
  id         String  @id @default(cuid())
  garageId   String
  garage     Garage  @relation(fields: [garageId], references: [id])
  account    String
  debit      Decimal @default(0) @db.Decimal(12, 2)
  credit     Decimal @default(0) @db.Decimal(12, 2)
  sourceType String
  sourceId   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([garageId, account])
}

// Written by the *_delete_guard BEFORE DELETE triggers on Invoice,
// Payment, AdvancePayment. The app never inserts, updates, or deletes
// these rows — Postgres does. See
// prisma/migrations/20260819160000_ledger_source_delete_guard/migration.sql
// for the trigger definitions and escape-hatch semantics.
//
// NOTE: only 'allowed' rows durably persist. The trigger writes a
// 'blocked' row and then RAISEs, which aborts the outer transaction
// and rolls the audit INSERT back along with the DELETE. The block
// is what has value here — the SQL-editor vector this guards
// couldn't reach an app-layer sink either. Column kept for a future
// app-layer shim.
model InvoiceDeleteAudit {
  id          String    @id @default(dbgenerated("gen_random_uuid()::text"))
  invoiceId   String
  garageId    String
  number      Int
  status      String
  subtotal    Decimal   @db.Decimal(12, 2)
  vatAmount   Decimal   @db.Decimal(12, 2)
  total       Decimal   @db.Decimal(12, 2)
  issuedAt    DateTime?
  outcome     String
  attemptedBy String
  note        String?
  attemptedAt DateTime  @default(now())

  @@index([garageId])
  @@index([outcome])
  @@index([attemptedAt])
}

model PaymentDeleteAudit {
  id          String   @id @default(dbgenerated("gen_random_uuid()::text"))
  paymentId   String
  invoiceId   String
  amount      Decimal  @db.Decimal(12, 2)
  method      String
  paidAt      DateTime
  outcome     String
  attemptedBy String
  note        String?
  attemptedAt DateTime @default(now())

  @@index([outcome])
  @@index([attemptedAt])
}

model AdvancePaymentDeleteAudit {
  id               String    @id @default(dbgenerated("gen_random_uuid()::text"))
  advancePaymentId String
  garageId         String
  jobCardId        String
  amount           Decimal   @db.Decimal(12, 2)
  method           String
  paidAt           DateTime
  migratedAt       DateTime?
  outcome          String
  attemptedBy      String
  note             String?
  attemptedAt      DateTime  @default(now())

  @@index([garageId])
  @@index([outcome])
  @@index([attemptedAt])
}

// ---------- Payables (AR 2026-08-30) ----------
// Full-accrual supplier side. Goods receipt auto-creates a bill and posts
// DR Inventory / CR AP; each SupplierPayment allocates its full amount
// across one or more open bills (no on-account balances) and posts
// DR AP / CR Cash per allocation. Bill void with allocated payments is
// blocked at the app; row DELETE on any of these three tables is blocked
// at the DB. Corrections are compensating entries only.
//
// The bill number is per-garage sequential + gapless, allocated via
// Garage.billSeq increment (same discipline as invoiceSeq / jobSeq).
// Rendered as "BILL-YYYY-NNNN" in the UI; the raw Int lives in the
// column so cross-year uniqueness stays enforced by (garageId, billNumber).
model SupplierBill {
  id              String              @id @default(cuid())
  garageId        String
  garage          Garage              @relation(fields: [garageId], references: [id])
  supplierId      String
  supplier        Supplier            @relation(fields: [supplierId], references: [id])
  purchaseOrderId String
  purchaseOrder   PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id])
  billNumber      Int
  // = PurchaseOrder.receivedAt at creation. Frozen; a later receive on the
  // same PO creates its OWN bill with its own billDate.
  // Date printed on the supplier's tax invoice. Captured on the
  // receive form (defaults to today; operator overrides to match
  // the supplier's paper). Aging clocks (C6) start from THIS date,
  // not the receive timestamp — "Net 30 from invoice date" is
  // industry standard, and a supplier who invoiced last Tuesday
  // ages against last Tuesday even if the parts arrived today.
  billDate        DateTime
  // Supplier's own invoice number as printed on the paper. Optional;
  // NO uniqueness — suppliers reuse numbers across years and a
  // duplicate should never block a receive. Purpose: match this row
  // back to the supplier's paper when they query a balance.
  supplierInvoiceRef String?
  subtotal        Decimal             @db.Decimal(12, 2)
  // VAT-input is 0 in MVP (gross-bill discipline, AR 2026-08-30 Q1
  // default). Column reserved so a later VAT-recovery phase does not
  // require a schema change.
  vatAmount       Decimal             @default(0) @db.Decimal(12, 2)
  total           Decimal             @db.Decimal(12, 2)
  // Running sum of allocations. Kept as a materialized column (updated
  // by recordSupplierPaymentAction inside the tx) so the list view
  // doesn't need a per-row aggregate to render balance. Ledger is
  // still the source of truth — if this drifts, the divergence is a
  // bug worth surfacing, not a friendlier number to show.
  paidAmount      Decimal             @default(0) @db.Decimal(12, 2)
  status          SupplierBillStatus  @default(OPEN)

  allocations SupplierPaymentAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([garageId, billNumber])
  @@index([garageId, status])
  @@index([supplierId])
  @@index([purchaseOrderId])
}

enum SupplierBillStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  VOID
}

// One supplier payment event. amount = SUM(allocations.amount) —
// enforced at the action (cross-row invariant, not expressible as a
// DB CHECK). No on-account balances: a lump sum paid against N
// bills allocates across N rows here.
model SupplierPayment {
  id         String   @id @default(cuid())
  garageId   String
  garage     Garage   @relation(fields: [garageId], references: [id])
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  amount     Decimal  @db.Decimal(12, 2)
  method     String
  paidAt     DateTime @default(now())
  note       String?

  allocations SupplierPaymentAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([garageId])
  @@index([supplierId])
  @@index([paidAt])
}

// Join row — one row per (payment, bill) with the amount applied to
// that bill from that payment. LedgerEntry rows keyed to allocation.id
// (sourceType='SUPPLIER_PAYMENT_ALLOCATION') so the aging query can
// resolve DR AP entries back to specific bills the same way the
// customer-side unpaidInvoicesAging resolves Payment → invoice today.
model SupplierPaymentAllocation {
  id                String          @id @default(cuid())
  supplierPaymentId String
  supplierPayment   SupplierPayment @relation(fields: [supplierPaymentId], references: [id])
  supplierBillId    String
  supplierBill      SupplierBill    @relation(fields: [supplierBillId], references: [id])
  amount            Decimal         @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([supplierPaymentId])
  @@index([supplierBillId])
}

// Delete-audit tables — same shape as InvoiceDeleteAudit /
// PaymentDeleteAudit. The BEFORE DELETE trigger writes 'blocked' here
// and RAISEs (rolling back both the audit insert and the DELETE, per
// the existing guard's escape-hatch semantics). Only 'allowed' rows
// durably persist. Triggers themselves land in the next migration
// (Payables C2), not this one.
model SupplierBillDeleteAudit {
  id                 String   @id @default(dbgenerated("gen_random_uuid()::text"))
  supplierBillId     String
  garageId           String
  supplierId         String
  billNumber         Int
  status             String
  subtotal           Decimal  @db.Decimal(12, 2)
  vatAmount          Decimal  @db.Decimal(12, 2)
  total              Decimal  @db.Decimal(12, 2)
  paidAmount         Decimal  @db.Decimal(12, 2)
  billDate           DateTime
  supplierInvoiceRef String?
  outcome            String
  attemptedBy        String
  note               String?
  attemptedAt        DateTime @default(now())

  @@index([garageId])
  @@index([outcome])
  @@index([attemptedAt])
}

model SupplierPaymentDeleteAudit {
  id                String   @id @default(dbgenerated("gen_random_uuid()::text"))
  supplierPaymentId String
  garageId          String
  supplierId        String
  amount            Decimal  @db.Decimal(12, 2)
  method            String
  paidAt            DateTime
  outcome           String
  attemptedBy       String
  note              String?
  attemptedAt       DateTime @default(now())

  @@index([garageId])
  @@index([outcome])
  @@index([attemptedAt])
}

// ---------- Expenses (E1a, AR 2026-08-30) ----------
// Money spent that isn't parts — rent, salaries, utilities, tools,
// etc. Direct posting per AR's Q3: an expense IS the cash-out event,
// no AP intermediary, no accrual step. Every row writes one
// balanced ledger pair on record (DR <expense account> / CR Cash),
// keyed sourceType='EXPENSE' (single source type per AR's Q2 —
// category is on the row, not in sourceType).
//
// VAT-input split deferred (E4 follow-up) per AR's Q4 — MVP expenses
// post gross. Rule 12 will document the deferral.
model Expense {
  id            String          @id @default(cuid())
  garageId      String
  garage        Garage          @relation(fields: [garageId], references: [id])
  category      ExpenseCategory
  // Money split — E1f (AR 2026-09-02) added subtotal + vatAmount
  // ahead of E4 (VAT summary). Rule 12: shop reclaims input VAT on
  // rent, utilities, tools, professional fees, etc; the pre-E1f
  // single-amount shape was systematically wrong on Form 201.
  //
  // total     = what cash actually left the shop (was `amount`).
  // vatAmount = reclaimable input VAT the operator EXPLICITLY entered.
  //             Defaults to 0 in the form — auto-calc from
  //             Garage.vatRate would silently claim VAT on categories
  //             that never carry it (SALARIES, most BANK_CHARGES),
  //             which corrupts the reclaim more than a missing entry
  //             does. Zero-default forces operator assertion.
  // subtotal  = total − vatAmount, stored for read-side simplicity
  //             (VAT summary + P&L don't recompute per read).
  //
  // Invariant: total = subtotal + vatAmount. Enforced in
  // recordExpenseAction — form refuses when vatAmount > total.
  //
  // Migration back-filled all pre-E1f rows as subtotal=amount,
  // vatAmount=0 per rule 12 cutover discipline: inventing a
  // 5/105 back-calc where no operator ever asserted it would
  // fabricate reclaim data.
  total         Decimal         @db.Decimal(12, 2)
  subtotal      Decimal         @db.Decimal(12, 2)
  vatAmount     Decimal         @db.Decimal(12, 2)
  // When cash left the shop. Single date because direct posting has
  // no accrual/paid distinction (per AR's Q3 direct-posting call).
  paidAt        DateTime
  method        String          // Cash / Bank Transfer / Card / Cheque / Other
  // Optional supplier link — a shop that pays rent to a supplier row
  // (some track landlords as suppliers) can tie the expense to it.
  // Nullable; most expenses (salaries, bank charges) won't have one.
  supplierId    String?
  supplier      Supplier?       @relation(fields: [supplierId], references: [id])
  note          String?
  // Supabase storage URL for a scanned receipt. Upload UI ships as
  // a follow-up commit — MVP accepts a typed URL only. Nullable.
  attachmentUrl String?
  // ACTIVE / VOID lifecycle. Correction path = void + re-record, per
  // AR's void-not-delete discipline (matches SupplierBill.status).
  status        ExpenseStatus   @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([garageId, paidAt])
  @@index([garageId, status])
  @@index([supplierId])
}

enum ExpenseCategory {
  RENT
  SALARIES
  UTILITIES
  TOOLS
  VEHICLE
  MARKETING
  BANK_CHARGES
  OFFICE
  REPAIRS_MAINT
  PROF_FEES
  MISC
}

enum ExpenseStatus {
  ACTIVE
  VOID
}

// Delete-audit table — same shape as SupplierBillDeleteAudit. The
// BEFORE DELETE trigger (lands in E1b) writes here and RAISEs.
// Only 'allowed' rows durably persist per the escape-hatch pattern.
model ExpenseDeleteAudit {
  id          String   @id @default(dbgenerated("gen_random_uuid()::text"))
  expenseId   String
  garageId    String
  category    String
  amount      Decimal  @db.Decimal(12, 2)
  paidAt      DateTime
  method      String
  status      String
  outcome     String
  attemptedBy String
  note        String?
  attemptedAt DateTime @default(now())

  @@index([garageId])
  @@index([outcome])
  @@index([attemptedAt])
}

// ---------- Import batches (E7, AR 2026-09-03) ----------
//
// Two-phase CSV import with a preview-then-commit gate. The parse
// action writes a DRAFT batch (parsed rows in `parsedRowsJson` +
// preview summary); the commit action reads that batch and applies
// per-row idempotent inserts, marking the batch COMMITTED. Rejected
// rows land in LedgerImportError with their reason.
//
// One row per import file. The `kind` names the target (customer /
// vendor / item / opening balance). Preview + commit share the same
// row so a browser reload between the two doesn't lose the parsed
// data.
//
// Not itself a ledger-writing table — the ledger writes it produces
// carry sourceType='OPENING_BALANCE' (or nothing, for the non-ledger
// kinds). A future audit-hardening phase may add a delete-guard
// trigger; deferred until a shop actually needs the trace back.
//
// See rule 17 (ships with E7b) for the discipline: idempotent-per-row,
// per-row failure reporting, never write on upload, refuse re-import
// for opening balances.

model LedgerImportBatch {
  id                String              @id @default(cuid())
  garageId          String
  garage            Garage              @relation(fields: [garageId], references: [id])
  uploadedByUserId  String
  uploadedBy        User                @relation("LedgerImportBatchUploader", fields: [uploadedByUserId], references: [id])
  kind              LedgerImportKind
  status            LedgerImportStatus  @default(DRAFT)
  fileName          String
  // Parsed rows as JSON — the exact shape the previewer built from
  // the CSV. Committer reads this back, not the original file. Kept
  // as JSON (not a normalised child table) because rows vary per kind
  // and the total is capacity-bounded (one operator upload, one shop).
  parsedRowsJson    Json
  // Summary counters computed by the previewer: create / skip / fail.
  // Rendered on the preview page without needing to re-scan
  // parsedRowsJson.
  previewSummaryJson Json
  // Populated when a row is committed successfully; the operator can
  // see who ran the commit + when it landed.
  committedAt       DateTime?
  committedByUserId String?
  committedBy       User?               @relation("LedgerImportBatchCommitter", fields: [committedByUserId], references: [id])
  discardedAt       DateTime?
  note              String?

  errors            LedgerImportError[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([garageId, status])
  @@index([garageId, kind])
  @@index([uploadedByUserId])
}

// One row per line the committer refused. `rowJson` snapshots the
// parsed row so the operator can see exactly what was rejected;
// `reason` names why in plain wording (duplicate phone, missing
// required field, opening-balance already imported for this
// customer, etc). rowIndex is the 1-based line in the CSV (excluding
// the header), so the operator can find it in their file.
model LedgerImportError {
  id        String            @id @default(cuid())
  batchId   String
  batch     LedgerImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowIndex  Int
  rowJson   Json
  reason    String

  createdAt DateTime @default(now())

  @@index([batchId])
}

enum LedgerImportKind {
  CUSTOMER
  VENDOR
  ITEM
  OPENING_BALANCE
}

enum LedgerImportStatus {
  DRAFT      // uploaded, parsed, preview computed, awaiting operator's Commit
  COMMITTED  // Commit ran; per-row inserts applied
  DISCARDED  // operator chose Discard on the preview; nothing written
}

// ---------- WhatsApp ----------
// Per-garage WhatsApp Business connection (Embedded Signup). Token stored ENCRYPTED.
model WhatsAppAccount {
  id             String       @id @default(cuid())
  garageId       String       @unique
  garage         Garage       @relation(fields: [garageId], references: [id])
  wabaId         String?
  phoneNumberId  String?      @unique
  phoneNumber    String?
  accessTokenEnc String? // AES-GCM ciphertext — never plaintext, never a raw token
  status         WaConnStatus @default(DISCONNECTED)
  connectedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WhatsAppThread {
  id                String         @id @default(cuid())
  garageId          String
  garage            Garage         @relation(fields: [garageId], references: [id])
  customerId        String
  customer          Customer       @relation(fields: [customerId], references: [id])
  waId              String
  mode              WaMode         @default(BOT) // BOT = AI handles; HUMAN = advisor took over
  threadStatus      WaThreadStatus @default(OPEN)
  assignedAdvisorId String?
  lastMessageAt     DateTime?
  // Advisor's last-viewed timestamp — the inbox counts inbound
  // messages with createdAt > lastReadAt as unread and renders a
  // pill count. Stamped on every /advisor/chats/[id] page load.
  // Null = never opened; every inbound reads as unread. AR
  // 2026-08-21 — Chats had no unread signal at all.
  lastReadAt        DateTime?

  messages WhatsAppMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([garageId, waId])
}

model WhatsAppMessage {
  id          String         @id @default(cuid())
  threadId    String
  thread      WhatsAppThread @relation(fields: [threadId], references: [id])
  direction   WaDirection
  template    String?
  body        String?
  waMessageId String         @unique // webhook idempotency
  status      String?
  aiGenerated Boolean        @default(false)
  state       WaMsgState     @default(SENT) // RECEIVED | SENT | PENDING_APPROVAL | DRAFT
  payloadJson Json?

  // AR 2026-08-19 — marks a row that was fabricated by a "simulate
  // customer message" test tool rather than sent by a real customer.
  // Sits alongside direction + state as an orthogonal audit fact:
  // "this row exists in the record but no human on the other end
  // actually spoke". False on every real message.
  //
  // Kept even though the write paths that produced sim- rows
  // (startTestConversationAction, simulateInboundAction) were
  // deleted in the same commit — the invariant we need is
  // "simulated messages are visibly distinguishable forever",
  // which needs a column, not a code check. Read sites that render
  // thread history to advisors show a "(SIMULATED)" tag on any
  // simulated=true row (see src/app/advisor/chats/[id]/page.tsx).
  //
  // Backfill in migration 20260819140000: every row with
  // waMessageId LIKE 'sim-%' gets simulated=true. The two probe
  // hits AR ran on 2026-08-19 confirmed 4 such rows in prod, 0
  // second-order outbound sent to real phones.
  simulated Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([threadId])
}

// ---------- AI usage metering (the margin trap) ----------
model AiEvent {
  id           String  @id @default(cuid())
  garageId     String
  garage       Garage  @relation(fields: [garageId], references: [id])
  userId       String?
  user         User?   @relation(fields: [userId], references: [id])
  kind         AiKind
  model        String // Opus vs Haiku is the biggest cost lever
  sourceType   String?
  sourceId     String?
  tokensIn     Int
  tokensOut    Int
  costEstimate Decimal @db.Decimal(12, 6)
  latencyMs    Int?

  createdAt DateTime @default(now())

  @@index([garageId, kind])
}

// ---------- Operator admin (separate from staff User) ----------
// Operator-level access for the cross-garage admin panel. Intentionally
// in its own table, with its own NextAuth provider, and NO garageId — an
// admin is above garages. A regular User row can NEVER become an admin;
// the only way to add admins is the scripts/create-admin.ts operator
// script. The /admin/* surface is gated by requireAdmin() which checks
// (1) JWT isAdmin marker, (2) row in this table, (3) not locked.
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  lastLoginAt  DateTime?
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())

  auditLogs AdminAuditLog[]
}

// Append-only audit trail of every admin interaction. Written by:
//   - requireAdmin() on each PASS (action="page_view") and DENY (action="access_denied")
//   - adminProvider.authorize() on login_failed / login_success
//   - middleware via /api/admin-access-denied for anonymous probes of /admin/*
// actorAdminId is nullable: anonymous denials + failed logins (where we
// only have the attempted email, not a confirmed admin id) record null.
// targetGarageId / targetType / targetId are convenience denormalisations
// for the per-garage detail view (Phase 3 cross-garage filters).
model AdminAuditLog {
  id             String     @id @default(cuid())
  actorAdminId   String?
  actor          AdminUser? @relation(fields: [actorAdminId], references: [id])
  action         String // page_view | access_denied | login_success | login_failed | ...
  targetType     String? // Garage | User | AdminUser | ...
  targetId       String?
  targetGarageId String?
  ip             String?
  userAgent      String?
  meta           Json?
  createdAt      DateTime   @default(now())

  @@index([actorAdminId, createdAt])
  @@index([targetGarageId, createdAt])
  @@index([action, createdAt])
}

// Plate history on a Vehicle. One row per (Vehicle, plate) tenure with
// the dates the plate was attached and released. The plate currently
// shown on the Vehicle is the one whose row has `releasedAt IS NULL`;
// the Vehicle.plate column stays as the fast-render cache for that
// current value.
//
// Slice 3 (2026-07-30) — introduced with the intake disambiguation
// panel. Choice 3 (plate transferred) writes both a release row on the
// old Vehicle and an attach row on the new one, atomic in the confirm
// action's transaction. Legacy Vehicles get a single backfilled row at
// migration time (attachedAt = Vehicle.createdAt, releasedAt = null),
// skipping any Vehicle whose plate is blank so we never insert an
// empty-plate history entry.
model VehiclePlateHistory {
  id               String    @id @default(cuid())
  vehicleId        String
  vehicle          Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  plate            String
  normalizedPlate  String
  attachedAt       DateTime  @default(now())
  releasedAt       DateTime? // null → this is the current plate on the Vehicle
  attachedByUserId String?
  attachedByUser   User?     @relation("PlateHistoryAttachedBy", fields: [attachedByUserId], references: [id])
  releasedByUserId String?
  releasedByUser   User?     @relation("PlateHistoryReleasedBy", fields: [releasedByUserId], references: [id])

  @@index([vehicleId, releasedAt])
  @@index([normalizedPlate, releasedAt])
}

// Ownership transfer audit. Append-only. Written in the confirm
// action's transaction whenever the disambiguation panel's Choice 2
// (same car, owner has changed) fires. The FK move happens on the
// Vehicle row (Vehicle.customerId → new Customer); the previous
// Customer's row is NEVER mutated in place — that would corrupt any
// other Vehicles / Bookings / Reminders still attached to the previous
// owner. Snapshot fields freeze what the previous owner looked like at
// transfer time so the audit doesn't lie later.
model VehicleOwnershipTransfer {
  id                  String   @id @default(cuid())
  vehicleId           String
  vehicle             Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  fromCustomerId      String
  fromCustomer        Customer @relation("OwnershipTransferFrom", fields: [fromCustomerId], references: [id])
  toCustomerId        String
  toCustomer          Customer @relation("OwnershipTransferTo", fields: [toCustomerId], references: [id])
  transferredAt       DateTime @default(now())
  transferredByUserId String
  transferredByUser   User     @relation("OwnershipTransferBy", fields: [transferredByUserId], references: [id])
  // Snapshot of the previous owner at transfer time — never joined
  // for read; kept for audit even if the previous Customer row is
  // later edited or deleted.
  previousOwnerName   String
  previousOwnerPhone  String

  @@index([vehicleId, transferredAt])
}

/// Short-lived scratch record for the Moulkia OCR pipeline. The advisor
/// scans the front, then the back, then lands on the confirm form —
/// three hops that used to carry the extracted owner name + VIN through
/// URL query params (visible in the browser URL bar, browser history,
/// server access logs, referrer headers). This row holds the OCR
/// extraction server-side; only its opaque cuid rides through the URL,
/// which combined with the garage-scoped read on every load gives the
/// capability model without any signing/encryption secret.
///
/// TTL = 2h from creation. On successful job-card create, the row is
/// deleted OUTSIDE the write transaction (a cleanup failure must never
/// roll back a job card that was already committed). Stale rows are
/// swept scoped to the current garage at the top of each front-photo
/// action so a busy branch doesn't pay for another's cleanup.
///
/// All fields nullable so the front-only extract can persist with just
/// owner + plate; back adds vin + make + model + year. Advisor can still
/// correct via the confirm form — the draft is a defaults source, not
/// the final write.
model IntakeDraft {
  id              String @id @default(cuid())
  garageId        String
  garage          Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdByUser   User   @relation("IntakeDraftCreatedBy", fields: [createdByUserId], references: [id])

  ownerName    String?
  plate        String?
  vin          String?
  make         String?
  model        String?
  year         Int?
  engineSize   String?
  fuelType     String?
  assignedToId String?

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([garageId, expiresAt])
  @@index([expiresAt])
}

// AR 2026-08-23. Standalone audit log for accounting-export downloads.
// The endpoint returns files containing the entire financial position
// of the business (general journal, invoices, payments, customers);
// each download writes one row here so there's a durable record of
// who took what data when.
//
// Deliberately has NO foreign key into any existing model. Owner-side
// User/Garage rows can be renamed, re-scoped, or (in theory) deleted
// without the audit trail cascading away — this row is the record of
// what happened at the moment it happened. userId and userRole are
// captured as flat strings so a later role change on the User row
// doesn't rewrite history. Same reasoning for scopeGarageIds, stored
// as a semicolon-separated list of cuids rather than a relation.
//
// Read via SQL editor / ad-hoc query; no in-app viewer today.
model AccountingExportLog {
  id             String   @id @default(cuid())
  userId         String
  userRole       String
  ownerGarageId  String
  scopeGarageIds String
  rangeFromIso   String
  rangeToIso     String
  file           String
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([ownerGarageId, createdAt])
}

// ---------- ERPNext one-way push (Phase 1: state tables only) ----------
// See ERPNEXT_SYNC_BRIEF.md — the operative document. §7 architecture:
// no outbox, tail the LedgerEntry table from a cursor. These three
// models are Phase 1 of §8: state tables + cursor. Nothing writes to
// them yet; Phase 2 wires the tailer, Phase 3 the ERPNext client.
//
// Constraint 3 of the brief (§1): additive only. New tables and new
// columns; do not modify existing actions, writers, or queries. This
// block adds three tables + Garage.erpSyncEnabled. That is the whole
// footprint on existing schema.

enum ErpSyncOp {
  // Master data — created before any invoice referencing them can push.
  PUSH_CUSTOMER
  PUSH_ITEM
  // Ledger events.
  PUSH_INVOICE
  PUSH_PAYMENT
  PUSH_ADVANCE
  PUSH_VOID
  // Deposit application against a Sales Invoice happens automatically
  // via allocate_advances_automatically = 1 (§5b of the brief) — no
  // separate ERPNext document. This op exists only to record the
  // GarageOS-side observation that a deposit was consumed by a specific
  // invoice, for reconciliation tie-out. It does NOT push a new record
  // to ERPNext; it POSTs a re-save on the invoice to trigger the
  // allocation, then reads back to assert outstanding_amount.
  APPLY_DEPOSIT
}

enum ErpSyncJobStatus {
  PENDING
  RUNNING
  SYNCED
  FAILED
  // Exhausted retries; the operator surface (Phase 6) lists these for
  // manual replay or resolution.
  DEAD_LETTER
}

// Idempotency spine (§7 of the brief). Maps a GarageOS-side entity
// (Customer / Item / Invoice / Payment / AdvancePayment) to its
// ERPNext-side name. The map row is written in the SAME transaction
// as marking the ErpSyncJob complete — a push that succeeds in ERPNext
// but fails to record its map row would duplicate the record on retry,
// and ERPNext assigns names by naming series so there is no natural
// key to recover from. See §7 "Idempotency — the one that corrupts
// ledgers".
model ErpEntityMap {
  id              String   @id @default(cuid())
  garageId        String
  garage          Garage   @relation(fields: [garageId], references: [id])
  // What GarageOS calls it. `garageosDoctype` mirrors the brief's
  // vocabulary; kept as a String rather than an enum so a new entity
  // kind added later doesn't require a schema migration.
  garageosDoctype String
  garageosId      String
  // What ERPNext calls it. Naming-series-generated names come back
  // opaque strings ("ACC-SINV-2026-00011"); we store them verbatim.
  erpnextDoctype  String
  erpnextName     String
  // Version bump on every subsequent push of the same entity (e.g.
  // Customer.name edited on the GarageOS side, re-pushed as an update).
  // Starts at 1.
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // The load-bearing uniqueness constraints (§3 of the brief calls out
  // the ERPNext-side unique index on Customer.garageos_customer_id /
  // Item.garageos_item_id as load-bearing; these are the GarageOS-side
  // mirror). A duplicate push fails at the database rather than
  // silently creating a second record.
  @@unique([garageId, garageosDoctype, garageosId])
  @@unique([garageId, erpnextDoctype, erpnextName])
  @@index([garageId, garageosDoctype])
}

// Per-op job row created by the tailer. `sourceType` + `sourceId`
// reference the originating GarageOS-side entity (typically a
// LedgerEntry.id for ledger-driven ops, or a Customer.id / Part.id
// for master-data ops). `dependsOnJobIds` lists other ErpSyncJob rows
// that must complete SYNCED before this one runs (§7 "Ordering": an
// invoice cannot post until its customer and every one of its items
// already exist in ERPNext).
model ErpSyncJob {
  id              String           @id @default(cuid())
  garageId        String
  garage          Garage           @relation(fields: [garageId], references: [id])
  op              ErpSyncOp
  // For ledger-driven ops (PUSH_INVOICE, PUSH_PAYMENT, PUSH_ADVANCE,
  // PUSH_VOID, APPLY_DEPOSIT), sourceType = "LedgerEntry" and sourceId
  // is a LedgerEntry.id. For master-data ops (PUSH_CUSTOMER, PUSH_ITEM),
  // sourceType = "Customer" | "Part" and sourceId is that row's id.
  sourceType      String
  sourceId        String
  // Barrier list: the tailer sets this at enqueue; the runner refuses
  // to pick the job up until every listed id has status = SYNCED.
  // Postgres array column so the runner can filter with a single
  // ANY/ALL query rather than a join table.
  dependsOnJobIds String[]         @default([])
  status          ErpSyncJobStatus @default(PENDING)
  attempts        Int              @default(0)
  // On FAILED / DEAD_LETTER: the assertion or HTTP error that broke
  // the push. `lastErrorField` names the specific §5 read-back field
  // that mismatched, when applicable — the operator surface renders it
  // so the shop's dispute is "outstanding_amount was 500 not 0", not
  // "ERPNext acted weird".
  lastError       String?
  lastErrorField  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  syncedAt        DateTime?

  // Idempotency for the tailer itself: enqueuing the same (garage, op,
  // sourceId) twice is a no-op at the DB level. The tailer runs
  // repeatedly and re-scans overlapping cursor windows on retry; this
  // constraint means a re-scan cannot double-enqueue.
  @@unique([garageId, op, sourceId])
  @@index([garageId, status, createdAt])
  @@index([status, createdAt])
}

// One row per garage. The tailer cursor advances monotonically over
// LedgerEntry rows in (createdAt, id) order. Compound cursor because
// LedgerEntry.id is a cuid — lexicographically sortable but not
// strictly monotonic across concurrent inserts within the same
// millisecond. Query shape:
//   WHERE (createdAt > lastLedgerCreatedAt)
//      OR (createdAt = lastLedgerCreatedAt AND id > lastLedgerId)
//   ORDER BY createdAt, id
//   LIMIT N
// Advancing the cursor is guarded by the ErpSyncJob unique constraint
// above — a repeated scan of the same window cannot double-enqueue,
// so the cursor can safely overlap by one row on each pass.
//
// Null defaults for a brand-new garage: cursor starts at the epoch;
// the first tail pass will pick up every ledger row from garage
// inception. Realistic first-pass sizes match §9 of the brief
// (17 customers, 45 invoices at trial).
model ErpSyncCursor {
  garageId            String   @id
  garage              Garage   @relation(fields: [garageId], references: [id])
  // No DB defaults on cursor position — the tailer's first pass per
  // garage upserts the row with lastLedgerCreatedAt = new Date(0),
  // lastLedgerId = "". Explicit app-side initialization avoids the
  // Prisma introspection round-trip that would normalize
  // 'epoch'::timestamp to its ISO form and leave permanent
  // schema-vs-migration drift on this table forever.
  lastLedgerCreatedAt DateTime
  lastLedgerId        String
  updatedAt           DateTime @updatedAt
}
